# Insert Wp: insertWpToolStripMenuItem_Click (GCSViews/FlightPlanner.cs:4070). Asks "Insert WP
# after wp#", offering the row after the selected one, and puts a WAYPOINT there at the click.
# A number Rows.Insert would throw on is refused with "Invalid insert position". Each OK keeps the
# answer as InputBox keeps every titled answer, before the handler reads it (InputBox.cs:73-84,
# 178-184).

screen plan
window 1600x1200
settle 4

click map@0.45x0.40
click map@0.60x0.55
expect mission.items 2

# Nothing selected: the offer is after the last row.
click map@0.30x0.70:right
click menu-insertWp
expect plan.prompt Insert WP
expect plan.prompt.text ~ Insert WP after wp
expect plan.prompt.value 2

# After waypoint 1 instead: the new row is waypoint 2, and selected.
key ctrl+u
type 1
key Return
expect plan.prompt none
expect config.InputBoxInsertWPInsertWPafterwp 1
expect mission.items 3
expect mission.commands 16,16,16
expect mission.selected 2

# A row that is not there.
click map@0.30x0.70:right
click menu-insertWp
key ctrl+u
type 9
key Return
expect plan.prompt Error
expect plan.prompt.text Invalid insert position
expect config.InputBoxInsertWPInsertWPafterwp 9
expect mission.items 3
key Return
expect plan.prompt none
