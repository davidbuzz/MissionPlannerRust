# Home is item 0 (PLAN.md 13.4 row 12, DELIVERABLES.md D11).
#
# Mission Planner keeps home out of the waypoint grid, in the Home Location boxes, and puts it back
# in front of the grid whenever a mission is written: savewaypoints writes it as record 0
# (GCSViews/FlightPlanner.cs:6108-6160) and saveWPs sends it as item 0 (:6196-6227). So the first
# click on an empty map is waypoint 1, never home. Reading a mission takes item 0 off as home and
# asks "Reset Home to loaded coords" when the boxes say otherwise (processToScreen, :5640-5669).
#
# The facts come from the text Save File writes: mission.written is each record's
# seq:frame:command, mission.written.home record 0's latitude, longitude and altitude.
#
# Self-contained: its own data directory, holding a config.xml with the home the
# planning screen saved last time, which MainV2 reads at start-up (MainV2.cs:1012-1025) and
# Activate puts in the boxes when no vehicle has sent one (FlightPlanner.cs:7208-7216).

env XDG_DATA_HOME $WORK
env MP_PLAN_DIR $WORK
setup mkdir -p "$WORK/MissionPlannerRust" && printf '<?xml version="1.0" encoding="utf-8"?><Config><TXT_homelat>-35.3632621</TXT_homelat><TXT_homelng>149.1652374</TXT_homelng><TXT_homealt>584.1</TXT_homealt></Config>' > "$WORK/MissionPlannerRust/config.xml"

screen plan
window 1600x1200
settle 4

# The saved home is in the boxes, and the grid is empty.
expect plan.home -35.3632621,149.1652374,584.10
expect mission.home true
expect mission.items 0

# Two clicks are waypoints 1 and 2, and what would be written has home at 0 in front of them.
click map@0.45x0.40
click map@0.60x0.55
expect mission.items 2
expect mission.written 0:0:16,1:3:16,2:3:16
expect mission.written.home -35.3632621,149.1652374,584.100000

# A home typed into the boxes is the one written (TXT_home*_TextChanged).
click plan-home-lat
# Entering the Lat box shows "Click on the Map to set Home " (TXT_homelat_Enter,
# FlightPlanner.cs:7016-7022); OK gives the box the keyboard back.
click plan-prompt-ok
key ctrl+u
type 51.5
click plan-home-lng
key ctrl+u
type 7.25
click plan-home-alt
key ctrl+u
type 100
expect plan.home 51.5,7.25,100
expect mission.written 0:0:16,1:3:16,2:3:16
expect mission.written.home 51.5000000,7.2500000,100.000000

# Saved and read back: record 0 goes back to home, not into the rows, and matches the boxes, so
# nothing is asked.
click plan-save
expect status ~ saved 2 items
click map@0.30x0.70:right
click menu-clearMission
expect mission.items 0
expect mission.home true
click plan-load
expect status ~ loaded 2 items
expect mission.items 2
expect mission.commands 16,16
expect plan.prompt none

# The boxes changed since: reading the file asks, and Yes takes its home.
click plan-home-lat
# Entering the Lat box shows "Click on the Map to set Home " (TXT_homelat_Enter,
# FlightPlanner.cs:7016-7022); OK gives the box the keyboard back.
click plan-prompt-ok
key ctrl+u
type 50
click plan-load
expect plan.prompt Reset Home Coords
expect plan.prompt.text Reset Home to loaded coords
click plan-prompt-ok
expect plan.prompt none
expect plan.home 51.5,7.25,100.00
expect mission.items 2

# Empty a box and there is no home: a write to a vehicle would be refused, and the file keeps
# its place for home with the blank record, the clicks still 1 and 2.
click plan-home-lat
# Entering the Lat box shows "Click on the Map to set Home " (TXT_homelat_Enter,
# FlightPlanner.cs:7016-7022); OK gives the box the keyboard back.
click plan-prompt-ok
key ctrl+u
expect mission.home false
expect mission.written 0:0:0,1:3:16,2:3:16
expect mission.written.home 0,0,0
