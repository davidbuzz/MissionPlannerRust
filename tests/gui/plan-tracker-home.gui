# Tracker Home: "Tracker Alt" / "Enter tracker ASL alt", offering the tracker's altitude when one
# is set and the vehicle's home altitude otherwise; OK sets `cs.TrackerLocation` to where the menu
# opened at that altitude, and the planner's timer draws a "Tracker Home" marker there - a green
# pin with its tooltip and a blue radius rect - while the tracker is not at home. A word that is
# not a number is double.Parse's exception. `GCSViews/FlightPlanner.cs:6910-6916, 6970-6982;
# ExtLibs/ArduPilot/CurrentState.cs:1606-1615`
#
# `cs.HomeAlt` is 0 until a HOME_POSITION has been heard, which nothing here asks for, so the
# box offers 0 to begin with.
#
#   tools/gui-test.sh tests/gui/plan-tracker-home.gui -- tcp:127.0.0.1:5760

env MP_CONFIG_XML $WORK/config.xml
env XDG_DATA_HOME $WORK
env MP_PLAN_DIR $WORK

screen plan
window 1600x1200
budget 9

# The vehicle first: a click before its first heartbeat is a click the screen may forget
# (vehicle.connected only says the link is open).
expect vehicle.count > 0
# The map first: a press before its first paint records nothing.
expect map.ready true
click map@0.40x0.40:right
click menu-trackerHome
expect plan.prompt Tracker Alt
expect plan.prompt.text Enter tracker ASL alt
expect plan.prompt.value 0
key ctrl+u
type 600
key Return
expect plan.prompt none
expect map.tooltip ~ Tracker Home : 600

# The box now offers the tracker's own altitude; a word is the exception.
click map@0.50x0.50:right
click menu-trackerHome
expect plan.prompt.value 600
key ctrl+u
type high
key Return
expect plan.prompt Error
expect plan.prompt.text ~ System.FormatException
key Return
expect plan.prompt none
expect map.tooltip ~ Tracker Home : 600
