# CONFIG's Planner page, ported from GCSViews/ConfigurationView/ConfigPlanner.cs.
#
# The claim: disconnected, SoftwareConfig lists the Planner page as the one to open first
# (SoftwareConfig.cs:257), and Activate fills every control from Settings.Instance - writing the
# severity's default and the aircraft icon's keys as it does (ConfigPlanner.cs:96-104, 239-245).
# Each control writes the key its handler writes, under the C#'s own name (config.planner.<key>),
# and the ones that act at once act: the unit combos run ChangeUnits (config.planner.units.*,
# MainV2.cs:4254-4337), a telemetry rate sets cs.rate (config.planner.rates), Enable Speech shows
# the speech boxes and each speech box asks for its templates in the C#'s InputBoxes
# (ConfigPlanner.cs:381-551), Map is rotated unticks No Fly (:755-765), Load Waypoints on connect
# sets the read on connect (MainV2.cs:1752-1761), Joystick Setup opens the joystick page
# (:552-555), and Enable HUD Overlay sets the HUD's hudon (hud.hudon), which MainV2 reads back at
# the next start (:374-378, MainV2.cs:940-941). The dimmed controls - theme, language, GDI+ and the rest - do nothing; the video
# controls are tests/gui/config-video.gui's.
#
# Settings.Instance is Mission Planner's config.xml, one dictionary: a handler puts its key in it
# as its control changes, and the file is written whole at the next SaveConfig - never by this
# page, which saves nothing, but at start-up, on the FLIGHT DATA button and on the close box
# (MainV2.cs:1109, 1311-1317, 2178). So config.saves stays at the start-up save while the page is
# used, and the dictionary holds each change at once (config.distunits is the dictionary's own
# fact, settings.rs's, for the key config.planner.distunits shows); FLIGHT DATA saves; and after
# `restart` - which closes through the close box, which saves again - the page, and what MainV2
# sets up from the file before any page shows, are what was read back from it.
#
# No link is needed: the rates' stream requests are proved against a scripted vehicle by the unit
# tests in crates/mp-gui/src/config/planner.rs; here, with no vehicle, none is sent. Mission
# Planner's own config.xml is kept out of it: the test has a file of its own, which the start-up
# save creates, and a scratch user data directory, so every key starts unset and there is no log
# directory. The same unit tests run this script step for step against the model. Run as
#
#   tools/gui-test.sh tests/gui/config-planner.gui

screen config
window 1600x1200
budget 25
env XDG_DATA_HOME $WORK
env MP_CONFIG_XML $WORK/config.xml

expect config.page ConfigPlanner
expect config.title Planner
expect config.planner.active true
expect config.planner.dimmed CHK_GDIPlus,CHK_Password,chk_ADSB,chk_analytics,CHK_beta,CHK_mavdebug,chk_temp,CMB_osdcolor,CMB_language,CMB_theme,BUT_themecustom,BUT_Vario

# SaveConfig ran once, at start-up, before the page was activated.
expect config.saved startup
expect config.saves 1
expect config.error none

# What Activate did with nothing set: Warning chosen and written, the icon's five boxes ticked and
# written True, the line length read as GMapMarkerBase_Length and written as GMapMarkerBase_length.
expect config.planner.severity 4
expect config.planner.combo.CMB_severity Warning
expect config.planner.GMapMarkerBase_DisplayCOG True
expect config.planner.GMapMarkerBase_DisplayTarget True
expect config.planner.GMapMarkerBase_length 500
expect config.planner.number.num_linelength 500
expect config.planner.number.NUM_tracklength 200
expect config.planner.number.num_gcsid 255
expect config.planner.combo.CMB_Layout Advanced
expect config.planner.combo.CMB_mapCache ServerAndCache
expect config.planner.cacheonly false

# The units: none set, so the combos show their first items and ChangeUnits gives metres.
expect config.planner.distunits none
expect config.distunits none
expect config.planner.combo.CMB_distunits Meters
expect config.planner.units.dist m
expect config.planner.units.alt m
expect config.planner.units.speed m/s
click planner-CMB_distunits
expect config.planner.dropdown CMB_distunits
click planner-CMB_distunits-Feet
expect config.planner.dropdown none
expect config.planner.distunits Feet
expect config.distunits Feet
expect config.planner.combo.CMB_distunits Feet
expect config.planner.units.dist ft
expect config.planner.units.alt m
click planner-CMB_altunits
click planner-CMB_altunits-Feet
expect config.planner.altunits Feet
expect config.planner.units.alt ft
click planner-CMB_speedunits
click planner-CMB_speedunits-knots
expect config.planner.speedunits knots
expect config.planner.units.speed kts

# A telemetry rate: the combo's name is the key, cs.rateattitude follows, and with no vehicle
# nothing goes on the wire.
expect config.planner.combo.CMB_rateattitude 4
expect config.planner.rates 4,2,2,2,2
click planner-CMB_rateattitude
click planner-CMB_rateattitude-10
expect config.planner.CMB_rateattitude 10
expect config.planner.combo.CMB_rateattitude 10
expect config.planner.rates 10,2,2,2,2
expect config.planner.streams none

# Speech: the boxes are hidden until it is enabled.
expect config.planner.check.CHK_speechwaypoint hidden
click planner-CHK_enablespeech
expect config.planner.speechenable True
expect config.planner.check.CHK_speechwaypoint false
# Waypoint asks for its template, starting from the C#'s; OK writes it. The OK also keeps the
# answer as InputBox keeps every titled answer, URL-encoded under "InputBox" and the caption and
# question with all but letters and digits taken out (InputBox.cs:73-84, 178-184).
expect config.InputBoxNotificationWhatdoyouwantittosay none
click planner-CHK_speechwaypoint
expect config.planner.speechwaypointenabled True
expect config.planner.prompt ~ Notification: What do you want it to say
expect config.planner.prompt.text Heading to Waypoint {wpn}
key Return
expect config.planner.prompt none
expect config.planner.speechwaypoint Heading to Waypoint {wpn}
expect config.InputBoxNotificationWhatdoyouwantittosay Heading+to+Waypoint+%7Bwpn%7D
# Mode, typed over. The same caption and question: the kept answer is the new one alone.
click planner-CHK_speechmode
expect config.planner.prompt.text Mode changed to {mode}
key ctrl+u
type Now in {mode}
key Return
expect config.planner.speechmode Now in {mode}
expect config.InputBoxNotificationWhatdoyouwantittosay Now+in+%7Bmode%7D
# Battery Warning asks three times; a Cancel on the second ends the handler, and keeps nothing.
click planner-CHK_speechbattery
key Return
expect config.planner.speechbattery WARNING, Battery at {batv} Volt, {batp} percent
expect config.InputBoxNotificationWhatdoyouwantittosay WARNING%2C+Battery+at+%7Bbatv%7D+Volt%2C+%7Bbatp%7D+percent
expect config.planner.prompt ~ Battery Level: What Voltage do you want to warn at
expect config.planner.prompt.text 9.6
click planner-prompt-cancel
expect config.planner.prompt none
expect config.planner.speechbatteryvolt none
expect config.InputBoxBatteryLevelWhatVoltagedoyouwanttowarnat none
expect config.planner.check.CHK_speechbattery true

# Map is rotated to follow the plane unticks No Fly, and both are written.
expect config.planner.check.chk_shownofly true
click planner-CHK_maprotation
expect config.planner.CHK_maprotation True
expect config.planner.check.chk_shownofly false
expect config.planner.ShowNoFly False

# The track length steps by its increment of 100 and is written as it changes.
click planner-NUM_tracklength-up
expect config.planner.number.NUM_tracklength 300
expect config.planner.NUM_tracklength 300

# The GCS id steps past 255, its maximum uint.MaxValue since e6454ccdd (ConfigPlanner.cs:92), and
# is MAVLinkInterface.gcssysid at once (:1058-1062).
click planner-num_gcsid-up
expect config.planner.number.num_gcsid 256
expect config.planner.gcsid 256
expect config.planner.gcssysid 256

# Load Waypoints on connect: the key, and the read on connect it stands for.
expect config.planner.readmissiononconnect false
click planner-CHK_loadwponconnect
expect config.planner.loadwpsonconnect True
expect config.planner.readmissiononconnect true

# The inactive aircraft style and the map access mode.
click planner-cmb_secondarydisplaystyle
click planner-cmb_secondarydisplaystyle-Transparent
expect config.planner.GMapMarkerBase_InactiveDisplayStyle Transparent
click planner-CMB_mapCache
click planner-CMB_mapCache-CacheOnly
expect config.planner.mapCache CacheOnly
expect config.planner.cacheonly true

# A dimmed box takes no click.
click planner-CHK_GDIPlus
expect config.planner.CHK_GDIPlus none
expect config.planner.check.CHK_GDIPlus false

# Enable HUD Overlay: ticked as the Designer has it, hudon true from the HUD's constructor. A click
# sets hudon and writes CHK_hudshow (ConfigPlanner.cs:375-379). No camera runs, so the HUD draws
# its instruments all the same (HUD.cs:1988-2013); config-video.gui unticks it over a picture.
expect config.planner.check.CHK_hudshow true
expect config.planner.CHK_hudshow none
expect hud.hudon true
expect hud.instruments true
click planner-CHK_hudshow
expect config.planner.check.CHK_hudshow false
expect config.planner.CHK_hudshow False
expect hud.hudon false
expect hud.instruments true

# Joystick Setup opens the joystick page in a window of its own, over this one.
click planner-BUT_Joystick
expect config.planner.joystick true
click planner-joystick-close
expect config.planner.joystick false

# Every change is in the dictionary, and none is on disk: the page saved nothing.
expect config.saves 1

# FLIGHT DATA: the page is hidden with CONFIG, the flight screen shown, and SaveConfig writes
# config.xml - every change above with it.
click tab-fly
expect config.planner.active false
expect config.saved fly
expect config.saves 2
expect config.error none

# Coming back opens the page again, as it was left; CONFIG saves nothing.
click tab-config
expect config.page ConfigPlanner
expect config.planner.active true
expect config.planner.combo.CMB_distunits Feet
expect config.planner.combo.CMB_speedunits knots
expect config.planner.units.alt ft
expect config.planner.check.CHK_speechwaypoint true
expect config.planner.check.CHK_maprotation true
expect config.saves 2
# With no capture Activate leaves the overlay box as the Designer has it, ticked, whatever hudon
# is (ConfigPlanner.cs:137-146); hudon stays as the click left it.
expect config.planner.check.CHK_hudshow true
expect hud.hudon false

# The close box, and the next start: its start-up save of what it read, then the page.
restart
expect config.saved startup
expect config.saves 1
expect config.error none
expect config.page ConfigPlanner
expect config.planner.active true

# The units, the rates and the read on connect, which MainV2 sets up from the file before any
# page shows (MainV2.cs:838, 983-1004, 1752-1761), and the combos Activate sets.
expect config.distunits Feet
expect config.altunits Feet
expect config.speedunits knots
expect config.planner.distunits Feet
expect config.planner.combo.CMB_distunits Feet
expect config.planner.combo.CMB_altunits Feet
expect config.planner.combo.CMB_speedunits knots
expect config.planner.units.dist ft
expect config.planner.units.alt ft
expect config.planner.units.speed kts
expect config.planner.CMB_rateattitude 10
expect config.planner.rates 10,2,2,2,2
expect config.planner.combo.CMB_rateattitude 10
expect config.planner.loadwpsonconnect True
expect config.planner.readmissiononconnect true
expect config.planner.check.CHK_loadwponconnect true
# hudon, which MainV2 reads from CHK_hudshow (MainV2.cs:940-941); the box the Designer's.
expect config.planner.CHK_hudshow False
expect hud.hudon false
expect config.planner.check.CHK_hudshow true

# What Activate wrote the first time is still there.
expect config.planner.severity 4
expect config.planner.combo.CMB_severity Warning
expect config.planner.GMapMarkerBase_length 500

# Speech, with the templates answered and the battery warning's cancelled question.
expect config.planner.speechenable True
expect config.planner.check.CHK_enablespeech true
expect config.planner.speechwaypointenabled True
expect config.planner.check.CHK_speechwaypoint true
expect config.planner.speechwaypoint Heading to Waypoint {wpn}
expect config.planner.speechmode Now in {mode}
expect config.planner.speechbatteryenabled True
expect config.planner.check.CHK_speechbattery true
expect config.planner.speechbattery WARNING, Battery at {batv} Volt, {batp} percent
expect config.planner.speechbatteryvolt none
expect config.InputBoxNotificationWhatdoyouwantittosay WARNING%2C+Battery+at+%7Bbatv%7D+Volt%2C+%7Bbatp%7D+percent
expect config.InputBoxBatteryLevelWhatVoltagedoyouwanttowarnat none

# The map boxes, the track length, the inactive style and the access mode.
expect config.planner.CHK_maprotation True
expect config.planner.check.CHK_maprotation true
expect config.planner.ShowNoFly False
expect config.planner.check.chk_shownofly false
expect config.planner.NUM_tracklength 300
expect config.planner.number.NUM_tracklength 300
# MainV2's uint.TryParse of gcsid (MainV2.cs:683-685), past a byte.
expect config.planner.gcssysid 256
expect config.planner.number.num_gcsid 256
expect config.planner.GMapMarkerBase_InactiveDisplayStyle Transparent
expect config.planner.combo.cmb_secondarydisplaystyle Transparent
expect config.planner.mapCache CacheOnly
expect config.planner.combo.CMB_mapCache CacheOnly
expect config.planner.cacheonly true

# A dimmed box's key was never written.
expect config.planner.CHK_GDIPlus none
