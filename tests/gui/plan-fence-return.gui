# Geo-Fence > Set Return Location, and Save to File's first question (PLAN.md 13.4, Deliverable 11).
#
# setReturnLocationToolStripMenuItem_Click puts the red "GeoFence Return" marker where the menu was
# opened, MouseDownStart (GCSViews/FlightPlanner.cs:6663-6670). saveToFileToolStripMenuItem_Click
# asks for none of the file until there is one: "Please set a return location" (:5959-5965).
#
# Its own data directory, with a home, so the map shows Canberra without a vehicle.

env XDG_DATA_HOME $WORK
env MP_PLAN_DIR $WORK
setup mkdir -p "$WORK/MissionPlannerRust" && printf '<?xml version="1.0" encoding="utf-8"?><Config><TXT_homelat>-35.3632621</TXT_homelat><TXT_homelng>149.1652374</TXT_homelng><TXT_homealt>584.1</TXT_homealt></Config>' > "$WORK/MissionPlannerRust/config.xml"

screen plan
window 1600x1200
budget 8

expect fence.return none

# Save to File with no return location says so, and asks for no file.
# The map first: a press before its first paint records nothing.
expect map.ready true
click map@0.30x0.70:right
click menu-geoFence
expect plan.menu.submenu menu-geoFence
click menu-saveToFile
expect plan.menu closed
expect plan.prompt message
expect plan.prompt.text Please set a return location
key Return
expect plan.prompt none

# Set Return Location: the marker is where the menu was opened, near home, and nothing else moves.
click map@0.50x0.50:right
click menu-geoFence
click menu-setReturnLocation
expect plan.menu closed
expect plan.prompt none
expect fence.return ~ -35.36
expect fence.return ~ 149.16
expect mission.items 0
expect fence.points 0

# Now Save to File asks for the file.
click map@0.30x0.70:right
click menu-geoFence
click menu-saveToFile
expect plan.prompt Save As
# The filter the C# gives the dialog, "Fence (*.fen)"; matched on its first word, as this
# harness would glob the star.
expect plan.prompt.text ~ Fence
key Escape
expect plan.prompt none
