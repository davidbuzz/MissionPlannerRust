# The flight screen's Scripts tab, ported from GCSViews/FlightData.cs:788-814, 1014-1019,
# 1223-1233, 1630-1641, 4727-4776 and FlightData.resx (PLAN.md §13.6 row 94, §12 D20).
#
# The claim: the tab shows the .resx's labels and buttons - "Script Status: No Script Running",
# "Selected Script: None", "Redirect Program Output", Select Script - Run Script and Edit
# Selected Script appear once a script is selected; Select Script is an OpenFileDialog for *.py,
# a typed path here; Run Script starts the script on "Script Thread (new)" with the status
# "Running", and with the output redirected the console shows what it prints - `cs.lat` from
# the vehicle, `Script.GetParam` from the parameters held, `Script.ChangeMode`'s literal true -
# until the script ends with "Script Status: Finished (or aborted)".
#
# Needs SITL copter on tcp:127.0.0.1:5760. Run as
#
#   tools/gui-test.sh tests/gui/fly-scripts.gui -- tcp:127.0.0.1:5760

env MP_CONFIG_XML $WORK/config.xml
screen fly
window 1600x1200
budget 15
expect vehicle.connected true

# The strip shows a few tabs at a time; Scripts is the eleventh, reached as fly-tabs.gui reaches
# it, one tab per press of the right arrow.
click fly-tabs-right
click fly-tabs-right
click fly-tabs-right
click fly-tabs-right
click fly-tabs-right
click fly-tabs-right
click fly-tabs-right
click fly-tabs-right
click fly-tabs-right
click fly-tabs-right
expect fly.tabs.first 10
click fly-tab-scripts
expect fly.tab tabScripts
expect fly.script.status Script Status: No Script Running
expect fly.script.selected Selected Script: None
expect fly.script.running false
expect fly.script.redirect false

# Select Script: the dialog, a typed path.
click fly-script-select
expect fly.prompt Python script (*.py)
type tests/gui/fixtures/hello.py
# Keystrokes come back through the input method; settle so the click cannot overtake them.
expect fly.prompt.value tests/gui/fixtures/hello.py
click fly-prompt-ok
expect fly.script.selected Selected Script: tests/gui/fixtures/hello.py

# Redirect the output so the console shows, then run.
click fly-script-redirect
expect fly.script.redirect true
click fly-script-run
expect fly.script.status Script Status: Finished (or aborted)
expect fly.script.running false
expect fly.script.result ok
expect fly.script.console ~ hello from the Scripts tab
expect fly.script.console ~ lat -35.36
expect fly.script.console ~ param 1000.0
expect fly.script.console ~ mode True
expect fly.script.console ~ done

# Clear empties the console.
click fly-script-console-clear
expect fly.script.console none
