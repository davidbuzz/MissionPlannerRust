# The flight screen's lower left is Mission Planner's tabControlactions: fourteen pages under the
# HUD, in the order the Designer adds them and with the .resx's words, Quick showing at start
# (SelectedIndex = 0), and one page at a time. Multiline is off by default, so the headers are one
# row and the two arrows at its end move it along a header at a time.
# `GCSViews/FlightData.Designer.cs:595-611, GCSViews/FlightData.resx, GCSViews/FlightData.cs:429`
#
# Every page must fit the column with a vehicle connected: fly.page.overflow is how far the page
# runs past the bottom of the column - its scroll range - and it is zero on every page.
#
# Needs SITL (a copter), so the pages carry what they carry with a vehicle on the link:
#   tools/gui-test.sh tests/gui/fly-tabs.gui -- tcp:127.0.0.1:5760

screen fly
window 1600x1200
budget 21

expect fly.tabs tabQuick,tabActions,tabPagemessages,tabActionsSimple,tabPagePreFlight,tabGauges,tabTransponder,tabStatus,tabServo,tabAuxFunction,tabScripts,tabPayload,tabTLogs,tablogbrowse
expect fly.tabs.text Quick,Actions,Messages,Actions,PreFlight,Gauges,Transponder,Status,Servo/Relay,Aux Function,Scripts,Payload Control,Telemetry Logs,DataFlash Logs
expect fly.tab tabQuick
expect fly.tab.text Quick
expect fly.tabs.first 0
expect fly.page.overflow 0

# The vehicle first: a click before its first heartbeat is a click the screen may forget
# (vehicle.connected only says the link is open).
expect vehicle.count > 0
click fly-tab-actions
expect fly.tab tabActions
expect fly.page.overflow 0

click fly-tab-messages
expect fly.tab tabPagemessages
expect fly.page.overflow 0

# The second Actions page reads the same; it is a page of its own.
click fly-tab-actionssimple
expect fly.tab tabActionsSimple
expect fly.tab.text Actions
expect fly.page.overflow 0

# The left arrow has nowhere to go yet.
click fly-tabs-left
expect fly.tabs.first 0

# From here each page is brought to the front of the row before it is chosen, so its header is
# in view whatever the font makes of the widths.
click fly-tabs-right
expect fly.tabs.first 1
click fly-tabs-right
expect fly.tabs.first 2
click fly-tabs-right
expect fly.tabs.first 3
click fly-tabs-right
expect fly.tabs.first 4
click fly-tab-preflight
expect fly.tab tabPagePreFlight
expect fly.page.overflow 0

click fly-tabs-right
expect fly.tabs.first 5
click fly-tab-gauges
expect fly.tab tabGauges
expect fly.page.overflow 0

click fly-tabs-right
expect fly.tabs.first 6
click fly-tab-transponder
expect fly.tab tabTransponder
expect fly.page.overflow 0

click fly-tabs-right
expect fly.tabs.first 7
click fly-tab-status
expect fly.tab tabStatus
expect fly.page.overflow 0

click fly-tabs-right
expect fly.tabs.first 8
click fly-tab-servo
expect fly.tab tabServo
expect fly.tab.text Servo/Relay
expect fly.page.overflow 0

click fly-tabs-right
expect fly.tabs.first 9
click fly-tab-auxfunction
expect fly.tab tabAuxFunction
expect fly.page.overflow 0

click fly-tabs-right
expect fly.tabs.first 10
click fly-tab-scripts
expect fly.tab tabScripts
expect fly.page.overflow 0

click fly-tabs-right
expect fly.tabs.first 11
click fly-tab-payload
expect fly.tab tabPayload
expect fly.tab.text Payload Control
expect fly.page.overflow 0

click fly-tabs-right
expect fly.tabs.first 12
click fly-tab-tlogs
expect fly.tab tabTLogs
expect fly.page.overflow 0

click fly-tabs-right
expect fly.tabs.first 13
click fly-tab-logbrowse
expect fly.tab tablogbrowse
expect fly.tab.text DataFlash Logs
expect fly.page.overflow 0

# The last header is the first shown: the right arrow has nowhere further to go.
click fly-tabs-right
expect fly.tabs.first 13

# Back to the start of the row, and back to Quick.
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
click fly-tabs-left
expect fly.tabs.first 0
click fly-tab-quick
expect fly.tab tabQuick
expect fly.page.overflow 0
