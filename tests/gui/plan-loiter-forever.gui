# Loiter > Forever: loiterForeverToolStripMenuItem_Click (GCSViews/FlightPlanner.cs:4763). A
# LOITER_UNLIM (17) at the click, at Default Alt (TXT_DefaultAlt, 100 as the .resx has it and as
# setfromMap takes it, FlightPlanner.cs:4758, 1164-1208), with no question asked.

screen plan
window 1600x1200
settle 4

click map@0.45x0.40:right
click menu-loiter
expect plan.menu.submenu menu-loiter
click menu-loiterForever
expect plan.menu closed
expect plan.prompt none
expect mission.items 1
expect mission.last.command 17
expect mission.last.position true
expect plan.defaultalt 100
expect mission.last.alt 100
expect mission.last.p1 0
