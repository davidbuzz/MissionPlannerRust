# CONFIG's Planner page: Video Device, Video Format, Start and Stop, and the camera under the HUD,
# on this machine's webcam. Ported from GCSViews/ConfigurationView/ConfigPlanner.cs and
# ExtLibs/WebCamService/Capture.cs, with V4L2 where the C# has DirectShow.
#
# The claim: with nothing saved, Activate lists no device (ConfigPlanner.cs:215-232). Clicking
# Video Device lists the capture devices by name - the webcam's capture nodes, not its metadata
# nodes, each named by its card and its node, "Integrated_Webcam_HD: Integrate (/dev/video0)",
# where DirectShow gives the bare name (the owner's ruling: two nodes share the card) - and
# binding the list selects the first, whose formats Video Format lists as the C#'s
# GCSBitmapInfo reads, "<w> x <h> <fps> fps <fourcc>", the first selected (:296-360, 741-750,
# 968-989). On Windows the devices are Media Foundation's, each by its bare friendly name, as
# DirectShow's list names them. Start opens the device in that format; once it runs, video_device and video_options
# are written as the two combos' indexes and frames arrive (:261-285); the flight screen's HUD
# draws the latest one under everything (HUD.cs:1986-2013, FlightData.cs:1897-1900). Enable
# HUD Overlay unticked sets hudon false, and the HUD paints the picture alone, its instruments
# hidden (:374-378, HUD.cs:2005-2008); Activate, while the capture runs, shows hudon in the box
# (:136-145); ticked again, the instruments are back. Stop ends the capture and the HUD's picture
# goes with it (:287-294, Capture.cs:142-157), and the instruments are drawn whatever hudon is.
#
# Needs a webcam that offers MJPEG or YUYV (YUY2 on Windows), and no other program holding it. It takes the
# camera for a few seconds; nothing else. The unit tests in crates/mp-gui/src/config/planner.rs
# run this script step for step against a scripted webcam laid out as this machine's. Run as
#
#   tools/gui-test.sh tests/gui/config-video.gui

screen config
window 1600x1200
budget 11
env XDG_DATA_HOME $WORK
env MP_CONFIG_XML $WORK/config.xml
# The capture is mp_video: V4L2 on Linux, Media Foundation on Windows. The tiny10 VM has no
# camera unless one is passed through to it (VirtualBox's webcam passthrough is its Extension
# Pack's), and without one there is nothing to list.
windows: setup powershell -NoProfile -Command 'if (-not (Get-PnpDevice -Class Camera,Image -PresentOnly -ErrorAction SilentlyContinue)) { Write-Error "no camera on this machine"; exit 3 }'

expect config.page ConfigPlanner
expect config.planner.active true
expect config.planner.video.devices 0
expect config.planner.video.running false
expect config.planner.video_device none
expect hud.camera none
expect hud.hudon true
expect hud.instruments true

# Click: the devices listed, each with its node, the first selected and its formats listed.
click planner-CMB_videosources
expect config.planner.dropdown CMB_videosources
expect config.planner.video.devices > 0
linux: expect config.planner.video.device ~ (/dev/video
expect config.planner.video.modes > 0
expect config.planner.video.mode ~ fps
click planner-CMB_videosources-0
expect config.planner.dropdown none
expect config.planner.video.modes > 0

# The first format, as binding the list left it.
click planner-CMB_videoresolutions
expect config.planner.dropdown CMB_videoresolutions
click planner-CMB_videoresolutions-0
expect config.planner.dropdown none
expect config.planner.video.mode ~ fps

# Start: the capture runs, the two indexes are written, the frames come.
click planner-BUT_videostart
expect config.planner.video.running true
expect config.planner.video.frames > 10
expect config.planner.video_device 0
expect config.planner.video_options 0
expect hud.camera ~ x

# The HUD on the flight screen, over the picture; then back to the page, still capturing.
click tab-fly
expect hud.camera ~ x
click tab-config
expect config.planner.video.running true
expect config.planner.video.frames > 10
expect hud.instruments true

# Enable HUD Overlay unticked while capturing: hudon false and saved, the picture alone.
expect config.planner.check.CHK_hudshow true
click planner-CHK_hudshow
expect config.planner.check.CHK_hudshow false
expect config.planner.CHK_hudshow False
expect hud.hudon false
expect hud.instruments false
click tab-fly
expect hud.camera ~ x
expect hud.instruments false
# Back to the page: the capture runs, so Activate shows hudon, unticked.
click tab-config
expect config.planner.check.CHK_hudshow false
expect hud.hudon false
# Ticked again: the instruments over the picture.
click planner-CHK_hudshow
expect config.planner.check.CHK_hudshow true
expect config.planner.CHK_hudshow True
expect hud.hudon true
expect hud.instruments true
# Unticked, to see Stop bring them back without it.
click planner-CHK_hudshow
expect hud.instruments false

# Stop: the capture ends and the picture with it; the settings stay; with no picture the
# instruments are drawn though hudon is false.
click planner-BUT_videostop
expect config.planner.video.running false
expect hud.camera none
expect hud.hudon false
expect hud.instruments true
expect config.planner.video_device 0
