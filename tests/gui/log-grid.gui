# The data grid under the log browser's chart, and the map beside it, as Log/LogBrowse.cs has
# them: a cell made current and put on the chart with Graph Left or Graph Right, the refusals of
# graphit_clickprocess in its own words, a header click filtering the grid to one type, and the
# route the log's GPS flew.
#
# Self-contained: it lays out a plan directory of its own with the healthy fixture, whose GPS never
# had a fix, and the damaged one, which came off a vehicle that had one.

env MP_PLAN_DIR $WORK/logs
# A config.xml of its own: the boxes the log browser remembers start as the designer has them.
env MP_CONFIG_XML $WORK/config.xml
setup mkdir -p $WORK/logs && cp testdata/dataflash.bin $WORK/logs/flight.bin && cp testdata/dataflash_damaged.bin $WORK/logs/gpsfix.bin

screen logs
window 1600x1200
budget 23
# 23: 20.3 s on 2026-10-06, the log's plots drawn in software on both timers; it had 20.

click log-name
type flight.bin
key Return

expect log.open true
expect log.grid.records 11439
# The grid is hidden, and has no rows, until the Data Table box shows it, as the C# opens.
expect log.check.datagrid false
expect log.grid.rows 0
click log-chk-datagrid
expect log.grid.rows 11439
expect log.refused none

# A filled grid makes its first cell current, and that is the line number: refused, in words.
expect log.grid.selected none
click log-graph-left
expect log.plotted 0
expect log.refused ~ Please pick another column

# Row 0 is the log declaring FMT itself. Its Type column is a field, but not one with a time series.
click loggrid-0-3
expect log.grid.selected FMT.Type
click log-graph-left
expect log.plotted 0
expect log.refused ~ cannot be plotted against time

# A click on a column header offers the log's types; ATT narrows the grid to its 182 records.
click loggrid-head-0
click loggrid-type-ATT
expect log.grid.rows 182
expect log.grid.records 11439

# ATT is TimeUS, DesRoll, Roll, DesPitch, Pitch...: Roll is column 5 and Pitch column 7.
click loggrid-0-5
expect log.grid.selected ATT.Roll
click log-graph-left
expect log.plotted 1
expect log.plotted.right 0
expect log.refused none

click loggrid-0-7
expect log.grid.selected ATT.Pitch
click log-graph-right
expect log.plotted 2
expect log.plotted.right 1

# The C#'s refusals on a data row: the line number, the time, and a column past ATT's ten fields.
click loggrid-1-0
click log-graph-left
expect log.plotted 2
expect log.refused ~ Please pick another column

click loggrid-1-1
click log-graph-right
expect log.refused ~ Cannot graph this field

click loggrid-1-13
click log-graph-left
expect log.refused ~ Invalid Field
expect log.plotted 2

# This log's GPS never had a fix: no track, and the six waypoints of the mission it logged.
expect log.map.points 0
expect log.map.waypoints 6

# Another log, whose GPS did have one.
click log-name
key Escape
type gpsfix.bin
key Return

expect log.open true
expect log.plotted 0
expect log.map.points > 0
expect log.map.points 408
