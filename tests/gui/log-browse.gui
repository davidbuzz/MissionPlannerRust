# Opening a dataflash log reads its fields; a left click plots one on the left axis and a right
# click on the right, as the tree in Log/LogBrowse.cs does.
#
# Self-contained: it lays out a plan directory of its own holding the healthy fixture as flight.bin.

env MP_PLAN_DIR $WORK/logs
# A config.xml of its own: the boxes the log browser remembers start as the designer has them.
env MP_CONFIG_XML $WORK/config.xml
setup mkdir -p $WORK/logs && cp testdata/dataflash.bin $WORK/logs/flight.bin

screen logs
window 1600x1200
settle 3

expect log.open false
expect log.fields 0

click log-name
type flight.bin
key Return
settle 3

expect log.open true
expect log.fields 643

click logfield-ATT.Roll
settle 1
expect log.plotted 1
expect log.plotted.right 0
expect log.axes.left 1

# A right click puts a field on the other axis.
click logfield-ATT.Pitch:right
settle 1
expect log.plotted 2
expect log.plotted.right 1

# And a click on a plotted field, whichever button, removes it.
click logfield-ATT.Roll:right
settle 1
expect log.plotted 1
expect log.plotted.right 1
expect log.axes.left 0
