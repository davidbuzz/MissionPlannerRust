# File Load/Save > Save WP File and Load WP File: saveWPFileToolStripMenuItem_Click and
# loadWPFileToolStripMenuItem_Click (GCSViews/FlightPlanner.cs:6181, 4738), which are the
# planning screen's own Save File and Load File.
#
# The file written starts with a home record whatever the boxes hold - here nothing, so it is the
# blank one savewaypoints writes (FlightPlanner.cs:6119) - and reading it back takes record 0 as
# home and leaves it out of the rows (processToScreen, :5667). So the two waypoints come back as
# waypoints 1 and 2, not as home and waypoint 1. A blank home is latitude 0, which is never
# offered to the boxes, so nothing is asked.
#
# Its own data directory, empty, so no home saved on this machine is in the boxes.

env XDG_DATA_HOME $WORK
# A home in a config.xml of the test's own: the planner's map has no view without one, and a
# click on a map without a view adds nothing.
setup mkdir -p "$WORK/MissionPlannerRust" && printf '<?xml version="1.0" encoding="utf-8"?><Config><TXT_homelat>-35.3632621</TXT_homelat><TXT_homelng>149.1652374</TXT_homelng><TXT_homealt>584.1</TXT_homealt></Config>' > "$WORK/MissionPlannerRust/config.xml"
env MP_PLAN_DIR $WORK

screen plan
window 1600x1200
budget 6

expect mission.home true

# The map first: a press before its first paint records nothing.
expect map.ready true
click map@0.45x0.40
click map@0.60x0.55
expect mission.items 2
expect mission.written 0:0:16,1:3:16,2:3:16

click map@0.30x0.70:right
click menu-fileLoadSave
expect plan.menu.submenu menu-fileLoadSave
click menu-saveWPFile
expect status ~ saved 2 items

click map@0.30x0.70:right
click menu-clearMission
expect mission.items 0

click map@0.30x0.70:right
click menu-fileLoadSave
click menu-loadWPFile
expect status ~ loaded 2 items
expect mission.items 2
expect mission.commands 16,16
expect plan.prompt none
expect mission.home true
expect mission.written 0:0:16,1:3:16,2:3:16
