# The port box's list with more rows than its thirty: a computer whose motherboard has ttyS0-3
# and a few adapters put the kinds past the thirtieth row, below the list's 600 px box, and the
# layout guard called them cut off (the owner's report of 2026-10-16, "CUT OFF on plugins at
# 1600x1200: main-port--dev-ttyS0..3, main-port-TCP, UDP, UDPCl, WS"). The list scrolls, as every
# drop-down here does past thirty rows (main.rs's dropdown), and its rows are a scrolling list's
# to the guard (layout_guard.rs's MAY_SCROLL): a run that ends with the long list open is judged
# with nothing cut off. The ttyS rows themselves are gone by his word of the same day
# (connect.rs's is_motherboard_uart), so the thirty-six here are adapters.
#
# MP_SERIAL_PORTS is the harness's door (crates/mp-transport/src/serial.rs): thirty-six adapters
# stand in for the computer's own, and AUTO and the five kinds go round them (MainV2.cs:1285-1292).
#
# No link needed. Run as
#
#   tools/gui-test.sh tests/gui/main-port-long-list.gui

screen plugins
window 1600x1200
budget 7
# 10: to be measured (2026-10-16).
env XDG_DATA_HOME $WORK
env MP_SETTINGS $WORK/settings.conf
env MP_SERIAL_PORTS /dev/ttyUSB0,/dev/ttyUSB1,/dev/ttyUSB2,/dev/ttyUSB3,/dev/ttyUSB4,/dev/ttyUSB5,/dev/ttyUSB6,/dev/ttyUSB7,/dev/ttyUSB8,/dev/ttyUSB9,/dev/ttyUSB10,/dev/ttyUSB11,/dev/ttyUSB12,/dev/ttyUSB13,/dev/ttyUSB14,/dev/ttyUSB15,/dev/ttyUSB16,/dev/ttyUSB17,/dev/ttyACM0,/dev/ttyACM1,/dev/ttyACM2,/dev/ttyACM3,/dev/ttyACM4,/dev/ttyACM5,/dev/ttyACM6,/dev/ttyACM7,/dev/ttyACM8,/dev/ttyACM9,/dev/ttyACM10,/dev/ttyACM11,/dev/ttyACM12,/dev/ttyACM13,/dev/ttyACM14,/dev/ttyACM15,/dev/ttyACM16,/dev/ttyACM17
setup mkdir -p "$WORK/MissionPlannerRust" && printf '<?xml version="1.0" encoding="utf-8"?><Config></Config>' > "$WORK/MissionPlannerRust/config.xml"

expect screen plugins
# The list: AUTO, thirty-six adapters and the five kinds.
click main-port
expect link.ports 42
# WS, the last row, is past the thirtieth: the wheel brings it into the box, and it is chosen.
reveal main-port-list main-port-WS
click main-port-WS
expect link.port WS
# The list open again, left so: the guard judges the run on this screen, and a scrolling list's
# rows out of sight are not a control cut off.
click main-port
expect link.ports 42
reveal main-port-list main-port-TCP
