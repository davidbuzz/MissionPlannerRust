# EXPERIMENTAL's Sort TLogs (temp.cs:224-239) and ReSort All logs (temp.cs:859-869), both
# LogSort.SortLogs (ExtLibs/Utilities/LogSort.cs). Sort TLogs asks for a folder, the log directory
# offered, and sorts its .tlogs - here a simulated copter's and one too small to be a log, two;
# ReSort All logs sorts every .tlog, .bin, .log and .rlog in the log directory and under it again -
# the two just sorted and a dataflash log, three. Where each lands is mp-log's log_sort tests'.
#
# Run as: tools/gui-headless.sh experimental-sortlogs
screen fly
window 1600x1200
budget 8
# 8: one run took 1.7 s (2026-10-06).
env XDG_DATA_HOME $WORK
env MP_CONFIG_XML $WORK/config.xml
env MP_LOG_DIR $WORK/logs
setup printf '<?xml version="1.0" encoding="utf-8"?><Config><tabcontrolactions>tabQuick;</tabcontrolactions></Config>' > "$WORK/config.xml"
setup mkdir -p "$WORK/logs" && cp testdata/mavlink/autotest.tlog "$WORK/logs/a.tlog" && cp testdata/dataflash.bin "$WORK/logs/b.bin" && printf small > "$WORK/logs/c.tlog"

key ctrl+f
expect screen experimental
expect experimental.sort none

# Sort TLogs: the folder offered, taken as it is.
click experimental-BUT_sorttlogs
expect experimental.asking ~ Browse For Folder
key Return
expect experimental.asking none
within 30
expect experimental.sort sorted 2

# ReSort All logs: no question.
click experimental-but_sortlogs
expect experimental.asking none
within 30
expect experimental.sort sorted 3
