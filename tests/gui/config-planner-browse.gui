# CONFIG > Planner > Browse: the C#'s FolderBrowserDialog (BUT_logdirbrowse_Click,
# GCSViews/ConfigurationView/ConfigPlanner.cs:779-786) as the planner's own chooser, as every file
# dialog here is (the owner's word of 2026-10-16; crates/mp-gui/src/file_list.rs). It opens over
# the page in the log folder Log Path names, listing `..` and its folders - no file, the log in it
# left out - a folder clicked is opened into its box, and OK puts the folder the box names in Log
# Path, which OnLogDirTextChanged writes as logdirectory (:788-795). A Cancel changes nothing.
#
# The test has a config.xml and a data directory of its own, so the log folder is the default one
# under it, made with two folders and a log by the setup line.
#
# Needs no link: tools/gui-test.sh tests/gui/config-planner-browse.gui

env XDG_DATA_HOME $WORK
env MP_CONFIG_XML $WORK/config.xml
setup mkdir -p "$WORK/MissionPlannerRust/logs/flights" "$WORK/MissionPlannerRust/logs/bench" && printf 'tlog' > "$WORK/MissionPlannerRust/logs/flight.tlog"

screen config
window 1600x1200
budget 8

expect config.page ConfigPlanner
expect config.planner.logdir ~ logs
expect config.planner.browse none

# Browse: the dialog, its box at the log folder, the folders listed and the log not.
click planner-BUT_logdirbrowse
expect config.planner.browse ~ logs
expect chooser.id planner-browse
expect chooser.type none
expect chooser.files ../,bench/,flights/

# Cancel: closed, Log Path as it was.
click planner-browse-cancel
expect config.planner.browse none
expect config.planner.logdir ~ logs

# Again; a folder clicked is opened into the box, and listed.
click planner-BUT_logdirbrowse
expect chooser.files ../,bench/,flights/
click chooser-file-2
expect config.planner.browse ~ flights
expect chooser.files ../

# OK: the folder in Log Path, and in logdirectory.
click planner-browse-ok
expect config.planner.browse none
expect config.planner.logdir ~ flights
expect config.planner.logdirectory ~ flights
