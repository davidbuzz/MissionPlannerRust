expect screen params
# RawParamWarning, on the Full Parameter List's Activate (ConfigRawParams.cs:92).
click raw-param-warning-ok
expect params.box none

# Load from file: the folder typed, its one file clicked, OK.
click param-load
expect params.file load
click param-file-value
key ctrl+a
type $WORK/params/
expect chooser.files ../,many.param
click chooser-file-1
expect params.file.typed ~ many.param
click param-file-ok
expect params.file none
# Every name missed, the box up and left so: four hundred names in a 500 px text that scrolls.
expect params.file.missed 400
expect params.box ~ No matching Params
expect params.box.text ~ Missing 400 params
