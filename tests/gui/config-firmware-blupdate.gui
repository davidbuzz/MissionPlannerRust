# Install Firmware's Force Bootloader failing, and Bootloader Update withheld, on the manifest page.
#
# Bootloader Update (ConfigFirmwareManifest.cs:535-562) - a MAVLinkInterface of its own, the two
# "BL Update" questions, then doCommand(FLASH_BOOTLOADER, 0, 0, 0, 0, 290876, 0, 0) - is withheld
# until it has been tested on a board, the owner's word of 2026-10-16, as EXPERIMENTAL's
# Bootloader Upgrade is: a press says only "this button isn't tested yet, sorry" and opens
# nothing (crates/mp-gui/src/config/firmware.rs, BOOTLOADER_UPDATE_TESTED). Its port stays, held
# to the C# by the unit tests (firmware.rs manifest_link_tests).
#
# Divergence, written at its site in crates/mp-gui/src/config/firmware.rs: Force Bootloader opens
# the port the port box shows.
#
# Offline: the catalogue is the test fixture, and the one USB device a CubeOrange by name, so
# nothing probes this machine's ports; the settings are scratch ones, so nothing is opened at
# start-up; no vehicle. Run as
#
#   tools/gui-test.sh tests/gui/config-firmware-blupdate.gui

env XDG_DATA_HOME $WORK
env TMPDIR $WORK
env MP_SETTINGS $WORK/settings.conf
env MP_FIRMWARE_MANIFEST $WORK/manifest.json.gz
env MP_FIRMWARE_MIRROR $WORK/web
env MP_FIRMWARE_DEVICE CubeOrange-BL
setup cp testdata/firmware/manifest.json.gz $WORK/manifest.json.gz
setup mkdir -p "$WORK/web" "$WORK/MissionPlannerRust" && printf '<?xml version="1.0" encoding="utf-8"?><Config></Config>' > "$WORK/MissionPlannerRust/config.xml"

screen setup
window 1600x1200
budget 16

expect vehicle.connected false
click setup-page-ConfigFirmwareManifest
expect config.firmware.page manifest
expect config.firmware.manifest loaded
expect config.firmware.bl none

# The port box on TCP.
click main-port
expect link.ports >= 5
reveal main-port-list main-port-TCP
click main-port-TCP
expect link.port TCP

# Force Bootloader (ConfigFirmwareManifest.cs:513-533) with the port box on TCP: Open(false) opens
# the window's link's serial port - here the one the port box shows, a divergence at its site -
# and a network kind is no serial port: "Failed to connect and send the reboot command" on the
# status line (a box in the C#), nothing opened, the page still the manifest page. The reboot
# itself is proved through the real link in the unit tests (firmware.rs manifest_link_tests), not
# here, where it would reboot the suite's SITL.
click fw-px4bl
expect status Failed to connect and send the reboot command
expect config.firmware.force none
expect config.firmware.message none
expect vehicle.connected false
expect link.button CONNECT
expect config.firmware.page manifest

# Bootloader Update, withheld: its words on the status line, no link of its own opened, no
# question, the window's link untouched.
click fw-bootloaderupdate
expect status this button isn't tested yet, sorry
expect config.firmware.bl none
expect link.prompt none
expect config.firmware.question none
expect vehicle.connected false
expect link.button CONNECT
expect config.firmware.page manifest
