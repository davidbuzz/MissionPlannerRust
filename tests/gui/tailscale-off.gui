# Tailscale unticked in the PLUGINS tab, the owner's word of 2026-10-14 ("look like a plugin,
# smell like a plugin, but not be an actual wasm plugin"): no indicator, no polling, no offer even
# with none installed, no Tailscale panel under the PLUGINS grid (the owner's complaint of
# 2026-10-16), and no guide's link on HELP. Started on PLUGINS, whose form opens with the window.
#
# Needs no link: tools/gui-headless.sh tailscale-off
screen plugins
window 1600x1200
budget 6
env XDG_DATA_HOME $WORK
env MP_CONFIG_XML $WORK/config.xml
env MP_TAILSCALE_CLI none
setup printf '<?xml version="1.0" encoding="utf-8"?><Config><DisabledPlugins>tailscale.native</DisabledPlugins></Config>' > "$WORK/config.xml"

expect tailscale.shown false
expect tailscale.state off
expect tailscale.offer none
# No built-in plugins here, so the native rows alone: Tailscale's unticked, and no panel.
expect screen plugins
expect plugin-manager.row.0 Tailscale|tailscale.native|disabled|dark-orange
expect plugin-manager.tailscale.panel false
click tab-help
expect screen help
expect help.tailscale false
