# Map Tool > Measure Distance: ContextMeasure_Click (GCSViews/FlightPlanner.cs:2625). The first
# choice remembers the point and says to choose again; the second reports "Distance: ... m AZ: ..."
# and forgets the first point.

env MP_CONFIG_XML $WORK/config.xml
# A home in the config, so the map frames Canberra: two presses on one row of a local view are
# a few hundred metres apart, due east of each other. At the world view the map opens with
# otherwise - (0, 0) at zoom 3, and the C#'s planner map does not jump to the first waypoint -
# the same two presses are 112 degrees of longitude apart at 45 N, and the great circle between
# them starts at 64 degrees (2026-09-26).
setup printf '<?xml version="1.0" encoding="utf-8"?><Config><TXT_homelat>-35.3632621</TXT_homelat><TXT_homelng>149.1652374</TXT_homelng><TXT_homealt>584.1</TXT_homealt></Config>' > "$WORK/config.xml"
screen plan
window 1600x1200
budget 7

# A waypoint first, so the map has a scale that is not the empty graticule's.
# The map first: a press before its first paint records nothing.
expect map.ready true
click map@0.50x0.50
click map@0.30x0.30:right
click menu-mapTool
click menu-ContextMeasure
expect plan.measure true
expect plan.prompt Measure Dist
expect plan.prompt.text ~ Click this option again to get the distance.
key Return
expect plan.prompt none

click map@0.70x0.30:right
click menu-mapTool
click menu-ContextMeasure
expect plan.measure false
expect plan.prompt message
expect plan.prompt.text ~ Distance:
expect plan.prompt.text ~ m AZ: 90
key Return
expect plan.prompt none
expect mission.items 1
