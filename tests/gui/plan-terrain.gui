# Terrain on the planning screen (PLAN.md 13.4 row 35): the altitude frame, Verify Height, and
# home taken from the ground - FlightPlanner.cs's srtm.getAltitude uses.
#
# CMB_altmode_SelectedIndexChanged keeps the choice and converts no row
# (GCSViews/FlightPlanner.cs:2157-2168); a new row takes it (:2347). With CHK_verifyheight ticked,
# setfromMap takes a new row's altitude from Default Alt and the ground (:1209-1236): Absolute
# the ground plus Default Alt, Terrain Default Alt, Relative the ground there less the ground
# under the planned home plus Default Alt. Entering the Lat box says "Click on the Map to set
# Home " and the next click moves home there (:566-571, 7016-7022), at the ground's height, as
# the map menu's Set Home Here does (:745-755, 6625-6632).
#
# Self-contained, no link: a data directory holding a flat tile at 584 m for SITL's field,
# S36E149.hgt, and a config.xml with a home and the Planner page's Map Access Mode at CacheOnly -
# which the terrain lookup follows (srtm.cs:385), so nothing is fetched.

env XDG_DATA_HOME $WORK
env MP_PLAN_DIR $WORK
setup mkdir -p "$WORK/MissionPlannerRust/srtm" && python3 -c 'import sys; open(sys.argv[1], "wb").write(bytes([2, 72]) * (1201 * 1201))' "$WORK/MissionPlannerRust/srtm/S36E149.hgt"
setup printf '<?xml version="1.0" encoding="utf-8"?><Config><TXT_homelat>-35.3632621</TXT_homelat><TXT_homelng>149.1652374</TXT_homelng><TXT_homealt>584.1</TXT_homealt><mapCache>CacheOnly</mapCache></Config>' > "$WORK/MissionPlannerRust/config.xml"

screen plan
window 1600x1200
budget 16

expect plan.srtm.cacheonly true
expect plan.home -35.3632621,149.1652374,584.10
expect plan.frame relative
expect plan.verifyheight false

# Verify Height clear: a click is Default Alt, 100.
# The map first: a press before its first paint records nothing.
expect map.ready true
click map@0.40x0.40
expect mission.items 1
expect mission.alts 100

# Ticked, Relative: (int)584 here + 100 - (int)584 under home = 100.
click plan-verifyheight
expect plan.verifyheight true
click map@0.45x0.60
expect mission.items 2
expect mission.alts 100,100

# Absolute: the ground, 584, plus Default Alt - 684.
click plan-frame-absolute
expect plan.frame absolute
click map@0.60x0.40
expect mission.items 3
expect mission.alts 100,100,684

# Terrain: Default Alt alone. The rows made before keep their frames and altitudes: choosing a
# frame converts nothing, and says nothing.
click plan-frame-terrain
expect plan.frame terrain
expect plan.prompt none
click map@0.60x0.60
expect mission.items 4
expect mission.alts 100,100,684,100
expect mission.frames relative,absolute,terrain
expect mission.written ~ ,1:3:16,2:3:16,3:0:16,4:10:16

# Default Alt 250, and Absolute again: 584 + 250.
click plan-defaultalt
key ctrl+u
type 250
click plan-frame-absolute
click map@0.50x0.30
expect mission.items 5
expect mission.alts 100,100,684,100,834

# The Lat box entered: the message once, OK gives the box back, and the next click on the map
# moves home there at the ground's height rather than adding a row.
click plan-home-lat
expect plan.prompt message
expect plan.prompt.text ~ Click on the Map to set Home
expect plan.sethome true
click plan-prompt-ok
expect plan.prompt none
click map@0.30x0.70
expect plan.sethome false
expect mission.items 5
expect plan.home ~ ,584.00

# Set Home Here: the ASL box typed away from the ground, then the menu puts it back.
click plan-home-alt
key ctrl+u
type 12.5
expect plan.home ~ ,12.5
click map@0.70x0.30:right
click menu-setHomeHere
expect plan.home ~ ,584.00
expect mission.items 5
