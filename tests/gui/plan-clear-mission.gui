# Clear Mission: clearMissionToolStripMenuItem_Click (GCSViews/FlightPlanner.cs:2064). Every row
# goes; home is not a row - it is the Home Location boxes' - so it stays, and so does the survey
# polygon.

screen plan
window 1600x1200
settle 4

click map@0.45x0.40
click map@0.55x0.45
click map@0.60x0.55
expect mission.items 3

click map@0.30x0.70:right
click menu-clearMission
expect plan.menu closed
expect mission.items 0
