# The SIMULATION tab's copter picture, as a pilot uses it: the simulator fetched and started, the
# application on FLIGHT DATA talking to it - its heartbeat, its parameters, a flight mode changed
# and changed back.
#
# `pictureBoxquad_Click` fetches ArduCopter's SITL (`CheckandGetSITLImage`: on Linux the
# `SITL_x86_64_linux_gnu` build named by ArduPilot's firmware manifest, 7 MB from
# firmware.ardupilot.org) and `StartSITL` runs it - `-M+ -O<home> -s1 --serial0 tcp:0` in the
# model's directory under the data directory's `sitl` - waits two seconds, shows FLIGHT DATA and
# connects to tcp:127.0.0.1:5760 (`SITL.cs:198-217, 604-738`). This runs the whole of that and
# then the connected vehicle's ordinary business: the parameter download that follows a connect
# and the Actions tab's mode buttons (`FlightData.cs`, `CMB_modes`/`but_setmode`).
#
# The owner's ask of 2026-09-26: a test that clicks the copter icon, launches the simulation,
# interacts with it and hears at least a heartbeat from it.
#
# Needs the network (the manifest and the simulator) and port 5760 free: the simulator this
# starts listens there, as Mission Planner's does, so a SITL already running - the one the other
# scripts are linked to - is refused by the setup line below, and the test does not run. The
# simulator exits when the application does (ArduPilot's SITL leaves with its parent). The data
# directory is a scratch one, so the download happens every run and nothing is left behind. Run
# from the repository root, with no link:
#   tools/gui-test.sh tests/gui/sitl-launch.gui

screen simulation
window 1600x1200
budget 19
env XDG_DATA_HOME $WORK
env MP_CONFIG_XML $WORK/config.xml
# Stable, as `cmb_version` index 2: the copter release the manifest publishes a Linux SITL for.
setup printf '<?xml version="1.0" encoding="utf-8"?><Config><sitl_download_version>2</sitl_download_version></Config>' > "$WORK/config.xml"
linux: setup if ss -Hltn 'sport = :5760' | grep -q .; then echo 'port 5760 is busy: this test launches its own SITL there; stop the one running first' >&2; exit 3; fi
windows: setup if netstat -an | grep -qE ':5760 +[^ ]+ +LISTENING'; then echo 'port 5760 is busy: this test launches its own SITL there; stop the one running first' >&2; exit 3; fi

expect screen simulation
# The launcher is the platform's, as the C# picks it: the manifest's build on Linux x64, the
# Cygwin folder on Windows (SITL.cs:269-375).
linux: expect sitl.launcher manifest SITL_x86_64_linux_gnu
windows: expect sitl.launcher cygwin
expect sitl.version Stable
# The H marker's place, which the page reads back from the map at its zoom - a few metres
# from the box's default text.
expect sitl.home ~ -35.36
expect sitl.running false
expect sitl.outcome none

# The copter picture: the fetch and the start, on a thread, the page busy meanwhile.
click sitl-picture-quad
expect sitl.running true
# The manifest, the 7 MB download, the start and its two seconds: inside the budget, which
# stops the run three seconds past itself.
within 25
expect sitl.outcome connect tcp:127.0.0.1:5760
expect sitl.arguments ~ -O-35.36
expect sitl.arguments ~ --serial0 tcp:0
expect sitl.running false

# `MainV2.View.ShowScreen(screens[0])` and `doConnect(comPort, "preset", "5760")`.
expect screen fly
expect vehicle.connected true
# The heartbeat: a vehicle heard on the link, the simulator just started.
within 20
expect vehicle.count > 0
expect vehicle.mode Stabilize
# The connect-time parameter download: every one of the simulator's.
within 30
expect params.held > 1000

# A conversation with it: a mode changed from the Actions tab and heard back in its heartbeat,
# then put back.
click fly-tab-actions
expect fly.tab tabActions
click AltHold
within 15
expect vehicle.mode AltHold
click Stabilize
within 15
expect vehicle.mode Stabilize
