# Load File and Save File with the JSON mission (ExtLibs/Utilities/MissionFile.cs). Load File
# reads a file whose first line starts "{" as one (GCSViews/FlightPlanner.cs:1866): home from
# plannedHomePosition, then each SimpleItem and each item of a ComplexItem's transect; any other
# type is passed over. Save File writes a name ending ".mission" as one (:6084).
#
# The plan is QGroundControl's: a takeoff, a waypoint, a survey of two waypoints, and an item of
# another type. Its home is the boxes' home, so nothing is asked.
#
# Mission Planner does not read back what it writes: its items carry no "type", so a .mission
# loads as its home alone (MissionFile.cs:114). That is the C#'s, and kept.
#
# A file that is not JSON stops the C# in its unhandled-exception dialog; here the exception is
# said on the status line.

env XDG_DATA_HOME $WORK
# A home in a config.xml of the test's own, the plan's home.
setup mkdir -p "$WORK/MissionPlannerRust" && printf '<?xml version="1.0" encoding="utf-8"?><Config><TXT_homelat>-35.3632621</TXT_homelat><TXT_homelng>149.1652374</TXT_homelng><TXT_homealt>584.19</TXT_homealt></Config>' > "$WORK/MissionPlannerRust/config.xml"
setup cp testdata/missions/qgc_survey.plan $WORK/survey.plan
setup printf '{ not a mission\n' > $WORK/broken.plan
env MP_PLAN_DIR $WORK

screen plan
window 1600x1200
budget 17
# 17: the first run took 14.7 s (2026-10-06) - three loads and a save, each through its box.

expect mission.home true
expect map.ready true

# QGroundControl's plan: four rows, the takeoff first.
click map@0.30x0.70:right
click menu-fileLoadSave
click menu-loadWPFile
expect plan.prompt Open
expect plan.prompt.files ~ survey.plan
type survey.plan
key Return
expect plan.prompt none
expect status ~ loaded 4 items
expect mission.items 4
expect mission.commands 22,16,16,16

# Saved as a .mission, and read back: home alone.
click map@0.30x0.70:right
click menu-fileLoadSave
click menu-saveWPFile
expect plan.prompt Save As
key ctrl+a
type flight.mission
key Return
expect plan.prompt none
expect status ~ saved 4 items to
expect status ~ flight.mission

click map@0.30x0.70:right
click menu-fileLoadSave
click menu-loadWPFile
expect plan.prompt Open
type flight.mission
key Return
expect plan.prompt none
expect status ~ loaded 0 items
expect mission.items 0

# Not JSON: the exception on the status line, the rows as they were.
click map@0.30x0.70:right
click menu-fileLoadSave
click menu-loadWPFile
expect plan.prompt Open
type broken.plan
key Return
expect plan.prompt none
expect status ~ JsonSerializationException
expect mission.items 0
