# EXPERIMENTAL's Param Restore (temp.cs:1267-1362), against SITL: "This process make take a some
# time", then the file asked for (ParamFile.FileMask), then its parameters written as the C# writes
# them - the "enable"s first, each other in its turn left alone when the vehicle already holds its
# value, an _id one set to 0 first - and the counts said at the end, on the status line here where
# the C# shows them in a box. The first file sets LOIT_BRK_DELAY and leaves MAV_SYSID, which the
# copter already has (this SITL's names: SYSID_THISMAV and WPNAV_SPEED_DN are older firmware's,
# and a name the vehicle has not got fails, as the C#'s GetParam throws for it); the second puts
# LOIT_BRK_DELAY back, for the scripts after this one, and names WPNAV_SPEED_DN, which fails.
#
# Run as: tools/gui-test.sh tests/gui/experimental-paramrestore.gui -- tcp:127.0.0.1:5760
screen fly
window 1600x1200
budget 20
# 20: one run took 8.6 s (2026-10-06).
env XDG_DATA_HOME $WORK
env MP_CONFIG_XML $WORK/config.xml
setup printf '<?xml version="1.0" encoding="utf-8"?><Config><tabcontrolactions>tabQuick;</tabcontrolactions></Config>' > "$WORK/config.xml"
setup printf 'MAV_SYSID,1\nLOIT_BRK_DELAY,1.5\n' > "$WORK/restore.param"
setup printf 'LOIT_BRK_DELAY,1\nWPNAV_SPEED_DN,150\n' > "$WORK/back.param"

within 30
expect vehicle.count > 0
within 60
expect params.held > 1000
key ctrl+f
expect screen experimental

click experimental-but_paramrestore
expect experimental.asking This process make take a some time
click experimental-message-ok
expect experimental.asking ~ Open:
click experimental-path-value
type $WORK/restore.param
key Return
expect experimental.asking none
within 20
expect status Set 1 params; Already Set 1 params

# And back as it was; the name this copter has not got, asked for and not found, failed.
click experimental-but_paramrestore
click experimental-message-ok
click experimental-path-value
type $WORK/back.param
key Return
within 20
expect status Set 1 params; Already Set 0 params; Failed to set WPNAV_SPEED_DN
