# The Advanced page's Param gen (ConfigAdvanced.cs:57-78, ExtLibs/Utilities/
# ParameterMetaDataParser.cs), ported in config/param_gen.rs, is withheld: the owner's word of
# 2026-10-14, "this need to be re-labled as 'no implemented yet', and hide the rest". Its button
# is dimmed and its click says config/advanced.rs's NOT_IMPLEMENTED_YET on the status line, with
# no "Downloading updated data" window and no run. The generation itself stays tested by
# param_gen.rs's unit tests.
#
# Needs SITL copter on tcp:127.0.0.1:5760. Run as
#   tools/gui-headless.sh -- tests/gui/config-paramgen.gui -- tcp:127.0.0.1:5760

env MP_CONFIG_XML $WORK/config.xml
env XDG_DATA_HOME $WORK
screen setup
window 1600x1200
budget 3

expect vehicle.count > 0
click setup-page-ConfigAdvanced
expect setup.page ConfigAdvanced
expect config.advanced.buttons.enabled !~ Param gen
expect config.advanced.dimmed ~ BUT_paramgen: not implemented yet
expect config.paramgen.running false
expect config.paramgen.started 0

# The button: the words, and nothing behind them.
click advanced-BUT_paramgen
expect status.drawn Param gen: not implemented yet
expect config.paramgen.running false
expect config.paramgen.started 0
expect config.paramgen.finished 0
expect config.paramgen.cancelled 0
expect config.paramgen.last none
