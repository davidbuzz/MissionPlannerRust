# CONFIG's MAVFtp page, ported from Controls/MavFTPUI.cs (PLAN.md §13.6 rows 62 and 71).
#
# The claim: SoftwareConfig lists the page for a vehicle reporting MAVLink FTP
# (SoftwareConfig.cs:211-216). Loading it lists "/" and "@SYS/", each a root of the tree - "/"
# with no name, as Path.GetFileName("/") has it - selects the last, @SYS, and lists it
# (MavFTPUI.cs:73-125, 151-203). Clicking the root lists it. The list's right-click menu makes a
# folder (New Folder's InputBox, :515-546), a double click opens it (:587-605), Upload writes two
# files into it at once - the File name box takes several names in double quotes, as
# OpenFileDialog's does with Multiselect - and checks the vehicle's CRC of each (:381-448),
# GetCRC32 shows a CRC in a box (:548-572), Download reads a file back into a folder (:324-379),
# Rename renames one in place (:482-513), a second click on a selected row renames another
# (LabelEdit's delayed edit, ending in the same ListView1_AfterLabelEdit), the list's keys select
# both and Delete removes them together (:450-480). Each is proved by the list the vehicle gives
# after. The tree's keys move its selection and list nothing (the C# wires no AfterSelect); its
# plus and the right button list a node and leave the selection (NodeMouseClick, :151-203).
#
# The scratch files are made in the run's scratch directory: the path boxes standing in for
# OpenFileDialog and FolderBrowserDialog take their paths typed, $WORK expanded by the runner.
#
# Needs SITL copter on tcp:127.0.0.1:5760 started from tools/sitl/params/copter.parm; its FTP root
# is SITL's working directory. Run as
#
#   tools/gui-test.sh tests/gui/config-mavftp.gui -- tcp:127.0.0.1:5760
#
# A run that stops half way can leave the folder mprtest in SITL's working directory; New Folder
# then puts "Failed to create directory" on the status line until a fresh SITL. A run to the end
# deletes it, the folder Delete of upstream's 54ce49a4b.

env MP_CONFIG_XML $WORK/config.xml
setup mkdir -p $WORK/mavftp/down && printf 'hello from the mavftp page\n' > $WORK/mavftp/hello.txt && printf 'second\n' > $WORK/mavftp/two.txt
screen params
window 1600x1200
budget 48
# 48: one run took 39.9 s with the folder delete added (2026-10-06).
# RawParamWarning, on the Full Parameter List's Activate (ConfigRawParams.cs:92): "Show me
# again?" unticked, so no later visit asks, and OK.
# The vehicle first: a click before its first heartbeat is a click the screen may forget
# (vehicle.connected only says the link is open).
expect vehicle.count > 0
click raw-param-warning-again
click raw-param-warning-ok

click param-download
expect params.held > 1000

click tab-config
expect config.pages ~ MavFTPUI
expect config.mavftp.active false
click config-page-MavFTPUI
expect config.page MavFTPUI
expect config.title MAVFtp
expect config.mavftp.active true
expect config.mavftp.busy false
expect config.mavftp.tree.enabled true

# Load: the two roots, @SYS selected and listed.
expect config.mavftp.tree ~ /,
expect config.mavftp.tree ~ @SYS/
expect config.mavftp.selected @SYS/
expect config.mavftp.list ~ uarts.txt
expect config.mavftp.item.uarts.txt.type File
expect config.mavftp.dialog none
expect config.mavftp.columns Name,Type,Size,Date modified

# The root, and a folder made in it.
click mavftp-node-/
expect config.mavftp.selected /
click mavftp-list:right
expect config.mavftp.menu true
click mavftp-menu-newfolder
expect config.mavftp.menu false
expect config.mavftp.prompt Folder Name
expect config.InputBoxFolderNameEnterfoldername none
type mprtest
key Return
expect config.mavftp.prompt none
# The OK keeps the name as InputBox keeps every titled answer (InputBox.cs:73-84, 178-184).
expect config.InputBoxFolderNameEnterfoldername mprtest
expect config.mavftp.list ~ mprtest
expect config.mavftp.item.mprtest.type Directory
# After a listing Mission Planner's label ends on "Ready", "/ Ready" or "/ Listing", by timing,
# and so does this. The handler sets "Ready" at once (MavFTPUI.cs:572-574) while the listing runs on
# a thread of the pool (MavFTPUI.cs:240-244); its "<dir> Listing" (MAVFtp.cs:1324) reaches the label
# through BeginInvoke, after "Ready", and its "<dir> Ready" (MAVFtp.cs:1480) only if 100 ms have
# passed since the last report the label took (MavFTPUI.cs:34-60) - which a SITL's quick listing
# often has not: config-mavftp failed here three runs in four on a new SITL (2026-10-06) with the
# label on "/ Listing" and the listing done. So the script asks that the work has ended.
expect config.mavftp.busy false

# Into it, and two files uploaded there at once, each in double quotes: their CRCs agree, or the
# status line would say so.
doubleclick mavftp-item-mprtest
expect config.mavftp.selected /mprtest
expect config.mavftp.list.count 0
click mavftp-list:right
click mavftp-menu-upload
expect config.mavftp.prompt Open
type "$WORK/mavftp/hello.txt" "$WORK/mavftp/two.txt"
key Return
expect config.mavftp.dialog none
expect config.mavftp.list.count 2
expect config.mavftp.list ~ hello.txt
expect config.mavftp.list ~ two.txt
expect config.mavftp.item.hello.txt.size 27B
expect config.mavftp.item.two.txt.size 7B

# GetCRC32: the box.
click mavftp-item-hello.txt
click mavftp-item-hello.txt:right
click mavftp-menu-crc
expect config.mavftp.message ~ hello.txt: 0x
click mavftp-message-ok
expect config.mavftp.message none

# Read back into a folder of its own.
click mavftp-item-hello.txt:right
click mavftp-menu-download
expect config.mavftp.prompt Browse For Folder
key ctrl+u
type $WORK/mavftp/down
key Return
expect config.mavftp.dialog none
expect config.mavftp.status ~ Ready

# Renamed in place from the menu.
click mavftp-item-hello.txt:right
click mavftp-menu-rename
expect config.mavftp.renaming hello.txt
key ctrl+u
type renamed.txt
key Return
expect config.mavftp.renaming none
expect config.mavftp.list ~ renamed.txt

# Renamed in place by a second click on the row once it is selected: the edit opens when the
# double-click time has passed with no other click (LabelEdit = true).
click mavftp-item-two.txt
expect config.mavftp.selection two.txt
settle 1
click mavftp-item-two.txt
expect config.mavftp.renaming two.txt
key ctrl+u
type second.txt
key Return
expect config.mavftp.renaming none
expect config.mavftp.list ~ second.txt

# The list's keys: Home selects the first row, Shift+End takes in the rest; the menu key opens
# the menu and Escape closes it.
click mavftp-item-second.txt
expect config.mavftp.keys list
key Home
key shift+End
expect config.mavftp.selection ~ renamed.txt
expect config.mavftp.selection ~ second.txt
key Menu
expect config.mavftp.menu true
key Escape
expect config.mavftp.menu false

# Both removed at once: the right button on a selected row keeps the selection.
click mavftp-item-second.txt:right
expect config.mavftp.selection ~ renamed.txt
click mavftp-menu-delete
expect config.mavftp.list.count 0
# Listed again after: as after New Folder, the work ended whatever the label says.
expect config.mavftp.busy false

# The tree's keys move its selection and list nothing.
click mavftp-node-/
expect config.mavftp.selected /
expect config.mavftp.list ~ mprtest
expect config.mavftp.keys tree
key End
expect config.mavftp.selected @SYS/
expect config.mavftp.list ~ mprtest
key Home
expect config.mavftp.selected /

# The right button on a node lists it and leaves the selection; the plus closes "/" and lists it.
click mavftp-node-@SYS/:right
expect config.mavftp.list ~ uarts.txt
expect config.mavftp.selected /
click mavftp-node-/-expand
expect config.mavftp.tree /,@SYS/
expect config.mavftp.list ~ mprtest
click mavftp-node-/-expand
expect config.mavftp.tree ~ /mprtest

# Sorting: the root's list by name, then back.
click mavftp-node-/
click mavftp-col-0
click mavftp-col-0
expect config.mavftp.list ~ mprtest

# Delete on a folder asks first (upstream's 54ce49a4b) - No leaves it - and Yes removes it with
# whatever is in it, deepest first (:450-504; MAVFtp.cs:594-631), so the run leaves SITL's
# directory as it found it.
click mavftp-node-/
expect config.mavftp.list ~ mprtest
click mavftp-item-mprtest:right
click mavftp-menu-delete
expect config.mavftp.delete.question Delete the folder mprtest and everything in it?
click mavftp-delete-question-no
expect config.mavftp.delete.question none
expect config.mavftp.list ~ mprtest
click mavftp-item-mprtest:right
click mavftp-menu-delete
click mavftp-delete-question-yes
within 20
expect config.mavftp.list !~ mprtest
expect config.mavftp.busy false

# Choosing another page hides this one.
click config-page-ConfigUserDefined
expect config.mavftp.active false
