# A REAL FLASH. This script writes ArduCopter stable to whatever CubeOrange is plugged in. It is
# run only on the owner's explicit word for that flash, never by the suite, and never with
# propellers fitted to anything the board is wired to. (PLAN.md §13.6 row 79)
#
# Install Firmware on the bench, as the C# does it: the page shows only while nothing is
# connected (InitialSetup.cs:169-173), so the application starts with no link - an empty
# config.xml of its own, since a `comport` there is opened at start-up - and the board's device
# reaches the flash host through MP_FIRMWARE_PORT, scaffolding that stands in for MainV2's port
# box until that is ported (PLAN.md §13.6 row 80). The catalogue comes from
# firmware.ardupilot.org, the board is named from its USB product string, Copter's picture is
# clicked, the CubeOrange build chosen and uploaded - UploadPX4 (Utilities/Firmware.cs:591-750):
# AttemptRebootToBootloader opens the comport, hears the heartbeat, sends the reboot into the
# bootloader and closes (:797-837); every port is scanned for thirty seconds for a bootloader with
# the firmware's board id; the image is erased, programmed, verified by CRC and the board rebooted
# - "Upload Done".
#
# Needs the board on its MAVLink USB interface at /dev/ttyACM0 and nothing else holding it.
# Run as
#
#   tools/gui-test.sh tests/gui/setup-firmware-flash-bench.gui

env XDG_DATA_HOME $WORK
env TMPDIR $WORK
# No saved link of this machine's: the application's own settings file is the test's, empty.
env MP_SETTINGS $WORK/settings.conf
env MP_FIRMWARE_PORT /dev/serial/by-id/usb-ArduPilot_CubeOrange_373532393330510F002E0019-if-mavlink
setup mkdir -p "$WORK/Mission Planner" && printf '<?xml version="1.0" encoding="utf-8"?><Config></Config>' > "$WORK/Mission Planner/config.xml"

screen setup
window 1600x1200
settle 4

expect vehicle.connected false
click setup-page-ConfigFirmwareManifest
# The whole manifest, tens of megabytes, from the mirror or ardupilot.org.
settle 45
expect config.firmware.active true
expect config.firmware.manifest loaded
expect config.firmware.board ~ CubeOrange
expect config.firmware.board.ids ~ 140

click fw-quad
settle 1
expect config.firmware.question ~ Are you sure you want to upload Copter
click fw-question-yes
settle 2
expect config.firmware.vehicle Copter
expect config.firmware.selection.selected https://firmware.ardupilot.org/Copter/stable/CubeOrange/arducopter.apj

# The download, the reboot, the scan, the upload: a couple of minutes at most.
click fw-select-upload
settle 150
expect config.firmware.flow done
expect config.firmware.apj.board_id 140
expect config.firmware.stopped none
expect config.firmware.status Upload Done
expect config.firmware.progress 100
expect config.firmware.flashed 140
