# Initial Setup's Secure page, ported from GCSViews/ConfigurationView/ConfigSecureAP.cs.
#
# InitialSetup lists it at the top while no vehicle is connected (isDisConnected,
# InitialSetup.cs:176-179), so this script runs with no link: the data directory is a scratch one,
# so no link Mission Planner remembers is opened. It needs no SITL.
#
# The claims: the page is listed, shows the Designer's two groups - "Do Only Once" with Generate
# Key, "Files" with Private Key, BootLoader and Firmware and the three text boxes beside them - and
# each button runs its handler (ConfigSecureAP.cs:30-111, SignedFW.cs): BootLoader with no key
# throws, which is said on the status line; Generate Key saves the key as PEM and the two .dat
# files and warns; Private Key reads the .dat back; BootLoader and Firmware then save signed copies
# beside the files. The file dialogs are typed paths. The files are the fixtures of
# testdata/secure, copied to the run's scratch directory ($WORK), where the signed copies and the key are written; the unit tests
# in crates/mp-firmware/src/signed.rs hold the signing to Mission Planner's own output.

env XDG_DATA_HOME $WORK
setup cp testdata/secure/bl.bin $WORK/secure-bl.bin
setup cp testdata/secure/unsigned.apj $WORK/secure-fw.apj

screen setup
window 1600x1200
budget 21

expect config.secure.active false
expect setup.pages ~ ConfigSecureAP
click setup-page-ConfigSecureAP
expect setup.page ConfigSecureAP
expect setup.title Secure
expect config.secure.active true
expect config.secure.groups Do Only Once,Files
expect config.secure.buttons Generate Key,Private Key,BootLoader,Firmware
expect config.secure.boxes txt_pubkey,txt_bl,txt_fwapj
expect config.secure.buttons.enabled true
expect config.secure.key false
expect config.secure.pubkey none

# BootLoader with no key: the path is shown, and CreateSignedBL's NullReferenceException - the
# C#'s unhandled-exception box - is on the status line.
click secure-but_bootloader
expect config.secure.dialog Open
type $WORK/secure-bl.bin
key Return
expect config.secure.dialog none
expect config.secure.bl $WORK/secure-bl.bin
expect status ~ NullReferenceException
expect config.secure.message none

# Generate Key: the key made, saved where the Save As dialog says - .pem added to a name without
# an extension - with the two .dat files beside it, the public key shown, and the warning.
click secure-but_generatekey
expect config.secure.dialog Save As
expect config.secure.key true
type $WORK/secure-key
key Return
expect config.secure.dialog none
expect config.secure.written ~ $WORK/secure-key.pem
expect config.secure.written ~ $WORK/secure-key_private_key.dat
expect config.secure.written ~ $WORK/secure-key_public_key.dat
expect config.secure.pubkey ~ =
expect config.secure.message Protect your private key, if lost there is no method to get it back.
click secure-message-ok
expect config.secure.message none

# Private Key reads the .dat back.
click secure-but_privkey
expect config.secure.dialog Open
type $WORK/secure-key_private_key.dat
key Return
expect config.secure.key true
expect config.secure.pubkey ~ =

# BootLoader and Firmware, signed beside themselves.
click secure-but_bootloader
type $WORK/secure-bl.bin
key Return
expect config.secure.written $WORK/secure-bl-signed.bin
click secure-but_firmware
type $WORK/secure-fw.apj
key Return
expect config.secure.fwapj $WORK/secure-fw.apj
expect config.secure.written $WORK/secure-fw-signed.apj

# Another page - the Optional Hardware heading, which fetches nothing - and Secure is no longer the
# page showing.
click setup-page-ConfigOptional
expect setup.page ConfigOptional
expect config.secure.active false
