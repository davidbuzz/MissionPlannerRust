# Initial Setup's FailSafe page, ported from GCSViews/ConfigurationView/ConfigFailSafe.cs.
#
# The claim: the page binds each control to the parameter the vehicle has (Activate,
# ConfigFailSafe.cs:24-89), shows what the vehicle holds, and a change to the throttle failsafe
# combo box is written to the vehicle when it is made - MavlinkComboBox's SelectedIndexChanged
# calls setParam (Controls/MavlinkComboBox.cs:169-199), there is no save button - and the vehicle
# echoes the new value; a number typed or stepped is written 300 ms later, and one typed above
# its maximum asks first. The values are put back at the end.
#
# Needs SITL copter on tcp:127.0.0.1:5760 started from tools/sitl/params/copter.parm, which sets
# FS_THR_ENABLE 1; the battery and GCS failsafes are at the firmware's defaults (0). Run as
#
#   tools/gui-test.sh tests/gui/config-failsafe.gui -- tcp:127.0.0.1:5760
#
# A run that stops half way leaves FS_THR_ENABLE at 3, BATT_LOW_VOLT at 10.8 or 10.7 or
# FS_THR_VALUE at 1100; the next run's first expectations fail, its restore steps still write 1,
# 10.5 and 975, and the run after that passes.

screen params
window 1600x1200
budget 24
# A config.xml of its own, so the "Show me again?" boxes this script clicks are not already
# suppressed by the settings of the machine running it.
env MP_CONFIG_XML $WORK/config.xml
# RawParamWarning, on the Full Parameter List's Activate (ConfigRawParams.cs:92): "Show me
# again?" unticked, so no later visit asks, and OK.
# The vehicle first: a click before its first heartbeat is a click the screen may forget
# (vehicle.connected only says the link is open).
expect vehicle.count > 0
click raw-param-warning-again
click raw-param-warning-ok

# Initial Setup lists the page only once every parameter is in (gotAllParams,
# InitialSetup.cs:120-131, 230-233). The connect-time download over MAVFTP is done within a
# second here, so "not yet available" cannot be caught; the page is available once it is in.
click param-download
expect params.held > 1000
expect config.failsafe.available true

# SETUP opens with its headings closed; the page is under Mandatory Hardware.
click tab-setup
click setup-page-ConfigMandatory
click setup-page-ConfigFailSafe
expect setup.page ConfigFailSafe
expect config.failsafe.open true
# Activate ends with a modal warning (ConfigFailSafe.cs:91-92).
expect config.failsafe.message Ensure your props are not on the Plane/Quad
click failsafe-message-ok
expect config.failsafe.message none

# What the page read. A 4.x copter has the newer battery names, so BATT_FS_LOW_ACT is chosen over
# FS_BATT_ENABLE and BATT_LOW_VOLT over FS_BATT_VOLTAGE (ConfigFailSafe.cs:30-68).
expect config.failsafe.throttle.param FS_THR_ENABLE
expect config.failsafe.throttle 1
expect config.failsafe.throttle.text Enabled always RTL
expect config.failsafe.throttle.options >= 7
expect config.failsafe.throttle.vehicle 1
expect config.failsafe.battery.param BATT_FS_LOW_ACT
expect config.failsafe.battery 0
# The text is the firmware's own documentation, fetched for the version flying (PLAN.md 10.5):
# the current Copter file labels 0 "Warn only" where the bundled older table said "None". The
# fetched file is read once the banner has named the firmware, so make sure it has been.
expect params.metadata.source ~ Copter
expect config.failsafe.battery.text Warn only
expect config.failsafe.voltage.param BATT_LOW_VOLT
expect config.failsafe.mah.param BATT_LOW_MAH
expect config.failsafe.timer.param BATT_LOW_TIMER
expect config.failsafe.pwm.param FS_THR_VALUE
expect config.failsafe.gcs.param FS_GCS_ENABLE
expect config.failsafe.gcs unchecked
# None of a plane's controls show on a copter.
expect config.failsafe.plane.shown 0

# The bars are RC_CHANNELS: SITL holds the throttle at the bottom of its travel, 1000, which is
# above FS_THR_VALUE's 975 - so the mode, coloured when it first reaches the label, is white
# rather than the red of a throttle failsafe (ConfigFailSafe.cs:173-192).
expect config.failsafe.ch3 >= 1000
expect config.failsafe.ch1 >= 1000
expect config.failsafe.mode.colour white
expect config.failsafe.armed Disarmed

# Change the throttle failsafe to "Enabled always Land" and prove the vehicle holds it.
click failsafe-FS_THR_ENABLE
click failsafe-FS_THR_ENABLE-3
expect config.failsafe.throttle 3
expect config.failsafe.throttle.text Enabled always Land
expect config.failsafe.write FS_THR_ENABLE 3 accepted
expect config.failsafe.throttle.vehicle 3

# And back.
click failsafe-FS_THR_ENABLE
click failsafe-FS_THR_ENABLE-1
expect config.failsafe.throttle 1
expect config.failsafe.write FS_THR_ENABLE 1 accepted
expect config.failsafe.throttle.vehicle 1

# The low battery voltage, typed: a click gives the box the focus, Enter reads the text, and
# MavlinkNumericUpDown writes it 300 ms later (Controls/MavlinkNumericUpDown.cs:133-180). The
# write is the float, so the vehicle echoes 10.8 as 10.800000190734863.
expect config.failsafe.voltage 10.5
expect config.failsafe.voltage.enabled true
click failsafe-BATT_LOW_VOLT
expect config.failsafe.editing BATT_LOW_VOLT
key ctrl+u
type 10.8
key Return
expect config.failsafe.voltage 10.8
expect config.failsafe.write ~ BATT_LOW_VOLT 10.8
expect config.failsafe.write ~ accepted
expect config.failsafe.voltage.vehicle ~ 10.8

# The arrows step by the documented 0.1: down to 10.7, and the timer writes it.
click failsafe-BATT_LOW_VOLT-down
expect config.failsafe.voltage 10.7
expect config.failsafe.voltage.vehicle ~ 10.7

# A throttle pwm typed above FS_THR_VALUE's documented 1100 asks "Out of range" first
# (MavlinkNumericUpDown.cs:136-145); No leaves the box held at 1100, which the handler then
# writes.
expect config.failsafe.pwm 975
click failsafe-FS_THR_VALUE
expect config.failsafe.editing FS_THR_VALUE
key ctrl+u
type 1150
key Return
expect config.failsafe.question ~ FS_THR_VALUE Value out of range
click failsafe-question-no
expect config.failsafe.question none
expect config.failsafe.pwm 1100
expect config.failsafe.pwm.vehicle 1100

# And both back.
click failsafe-FS_THR_VALUE
key ctrl+u
type 975
key Return
click failsafe-BATT_LOW_VOLT
key ctrl+u
type 10.5
key Return
expect config.failsafe.pwm.vehicle 975
expect config.failsafe.voltage.vehicle 10.5
expect config.failsafe.message none

# Choosing another page deactivates this one (BackstageView.cs:453-464), and the page is closed.
click setup-page-ConfigFlightModes
expect setup.page ConfigFlightModes
expect config.failsafe.open false
