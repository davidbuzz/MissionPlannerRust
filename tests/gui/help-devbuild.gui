# HELP's two update buttons on a development build - `cargo build`'s, target/debug/planner, which
# is the owner's local working copy and every planner but the release workflow's
# (crates/mp-update/src/identity.rs; updates.md, section 4.3).
#
# The claim: a development build updates when a button asks (the owner, 2026-11-18). It cannot
# say which release it is, so each button is offered whatever its channel holds, "a development
# build to ..."; No leaves everything alone. What it does not do is ask at startup - though the
# settings below, beta updates on and no day checked, would have a release ask at once.
#
# Against tests/gui/update-server.py on 127.0.0.1:5795. Yes, and the install that follows, is
# help.gui's and help.rs's tests': the new planner there is a shell script standing for one.
#
# Needs no link: tools/gui-headless.sh help-devbuild

env XDG_DATA_HOME $WORK
env MP_UPDATE_DIR $WORK/install
setup mkdir -p "$WORK/install" "$WORK/MissionPlannerRust"
setup python3 tests/gui/update-server.py --work $WORK --port 5795
setup printf '<?xml version="1.0" encoding="utf-8"?><Config><UpdateManifest>http://127.0.0.1:5795/update.json</UpdateManifest><BetaUpdateManifest>http://127.0.0.1:5795/beta/update.json</BetaUpdateManifest><beta_updates>True</beta_updates></Config>' > "$WORK/MissionPlannerRust/config.xml"

screen help
window 1600x1200
budget 6

expect screen help
expect help.build ~ (development build)

# Nothing asked at startup.
expect help.flow idle
expect help.last none

# Check for Updates: the stable channel's release, offered. No.
click help-updatecheck
expect help.flow question
expect help.question Update Found: a development build to 0.0.2 [link;http://127.0.0.1:5795/releases/tag/v0_0_2;ChangeLog]
click help-question-no
expect help.flow idle

# Check for BETA Updates: the beta's build, offered. No, and nothing touched.
click help-betaupdate
expect help.flow question
expect help.question BETA Update Found: a development build to 9f8e7d6c5b4a built 2026-11-25 [link;http://127.0.0.1:5795/releases/tag/beta;ChangeLog]
click help-question-no
expect help.flow idle
expect help.refused 0
expect help.written 0
expect help.restart none
expect help.installed false
