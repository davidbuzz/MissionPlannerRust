# The planning map's zoom (DELIVERABLES.md D8, D11).
#
# The zoom icon on the map (zoomicon, GCSViews/FlightPlanner.cs:4910-4911, 7624-7628) opens
# contextMenuStripZoom: Zoom to Vehicle centres on cs.Location, Zoom to Home on cs.HomeLocation or
# else the planned home, each bringing a wider view in to 17, and Zoom to Mission is
# MainMap.ZoomAndCenterMarkers("WPOverlay") (FlightPlanner.cs:8370-8401). The Zoom box and bar at
# the map's right set MainMap.Zoom and show it (Zoomlevel_ValueChanged, TRK_zoom_Scroll,
# MainMap_OnMapZoomChanged; FlightPlanner.cs:6938-6969, 8012-8029). Map Tool > Zoom To asks for a
# place (FlightPlanner.cs:8345-8368), and is cancelled here: its answer comes from OpenStreetMap's
# geocoder, and a test asks no server anything.
#
# Its own data directory, with the planned home at SITL's, so Zoom to Home lands in the same place
# whether or not the vehicle's HOME_POSITION has been heard.
#
# Needs SITL (a copter): tools/gui-test.sh tests/gui/plan-zoom.gui -- tcp:127.0.0.1:5760

env XDG_DATA_HOME $WORK
env MP_PLAN_DIR $WORK
setup mkdir -p "$WORK/MissionPlannerRust" && printf '<?xml version="1.0" encoding="utf-8"?><Config><TXT_homelat>-35.3632621</TXT_homelat><TXT_homelng>149.1652374</TXT_homelng><TXT_homealt>584.1</TXT_homealt></Config>' > "$WORK/MissionPlannerRust/config.xml"

screen plan
window 1600x1200
budget 16

expect vehicle.connected true

# The bar near its foot: a low zoom (TRK_zoom_Scroll), which the box shows.
click plan-trk-zoom@0.5x0.9
expect map.zoom.step < 5

# Zoom to Home: home centred, the view brought in to 17.
click plan-zoomicon
expect plan.zoommenu open
click menu-zoomToHome
expect plan.zoommenu closed
expect map.zoom 17.00
expect plan.zoomlevel 17.0
expect map.centre ~ -35.363
expect map.centre ~ 149.165

# The box's arrows: half a zoom each (Zoomlevel.Increment).
click plan-zoomlevel-up
expect map.zoom 17.50
expect plan.zoomlevel 17.5
click plan-zoomlevel-down
click plan-zoomlevel-down
expect map.zoom 16.50

# Zoom to Vehicle: the vehicle centred, and 16.5 brought in to 17.
click plan-zoomicon
click menu-zoomToVehicle
expect plan.prompt none
expect map.zoom 17.00
expect map.centre ~ -35.36
expect map.centre ~ 149.16

# A closer view is left as it is.
click plan-zoomlevel-up
click plan-zoomicon
click menu-zoomToVehicle
expect map.zoom 17.50

# Zoom to Mission: home and two waypoints, framed at the whole zoom that fits them.
# The map first: a press before its first paint records nothing.
expect map.ready true
click map@0.30x0.30
click map@0.70x0.70
expect mission.items 2
click plan-trk-zoom@0.5x0.9
expect map.zoom.step < 5
click plan-zoomicon
click menu-zoomToMission
expect map.zoom.step > 14
expect map.zoom ~ .00

# A click off the open menu closes it and adds nothing.
click plan-zoomicon
expect plan.zoommenu open
click map@0.80x0.20
expect plan.zoommenu closed
expect mission.items 2

# Map Tool > Zoom To asks where, Perth Airport offered; Cancel asks the geocoder nothing.
click map@0.50x0.50:right
click menu-mapTool
click menu-zoomTo
expect plan.prompt Location
expect plan.prompt.text Enter your location
expect plan.prompt.value Perth Airport, Australia
key Escape
expect plan.prompt none
expect plan.geocoding false

# The flight screen's own radius circle: the Guided Mode marker (FlightData.cs:4214-4221). Fly To
# Coords puts the vehicle in Guided and sends it somewhere, and the marker there is circled at the
# WP radius, in blue, its tooltip always showing. The mission's waypoints have no circles on this
# screen: its overlay is built with no radii (FlightData.cs:3830-3843).
click tab-fly
expect map.circles 0
click fly-tab-actions
click fly-flytocoords
# The minus as a key: `xdotool type -35...` would read the text as an option.
key minus
type 35.3625;149.1657;20
expect fly.prompt.value -35.3625;149.1657;20
click fly-prompt-ok
expect vehicle.mode Guided
expect map.circles 1
expect map.tooltip ~ Guided Mode : 20

# Out of Guided, and the marker goes.
click Stabilize
expect vehicle.mode Stabilize
expect map.circles 0
