# The log browser's data grid, as Log/LogBrowse.cs wires it beyond a click: its right-click menu
# (contextMenuStrip1) - Export Visible writes every row the grid holds to a CSV beside the log,
# Export Files the files the log carries into a folder - Ctrl+G's "Line no", and a double click
# on a row, which moves the chart's cursor and the map's marker to its record.
#
# Self-contained: the healthy fixture, and the damaged one, which carries five files in 134 FILE
# records; a config.xml of its own.

env MP_PLAN_DIR $WORK/logs
env MP_CONFIG_XML $WORK/config.xml
setup mkdir -p $WORK/logs && cp testdata/dataflash.bin $WORK/logs/flight.bin && cp testdata/dataflash_damaged.bin $WORK/logs/gpsfix.bin

screen logs
window 1600x1200
budget 26

click log-name
type flight.bin
key Return

click log-chk-datagrid
expect log.grid.rows 11439

# Ctrl+G, with the screen holding the keyboard: a line, one-based.
click loggrid-0-2
settle 0.3
key ctrl+g
expect log.prompt Line no
type 100
key Return
expect log.prompt none
expect log.grid.current 99,1
expect log.refused none

# The grid filtered to ATT, then its menu's Export Visible: 182 rows, beside the log.
click loggrid-head-0
click loggrid-type-ATT
expect log.grid.rows 182
click loggrid-0-3:right
expect log.grid.menu true
click loggrid-menu-visible
expect log.grid.menu false
expect log.prompt Save As
click log-prompt-ok
expect log.prompt none
expect log.exported 182 rows

# A double click on a row puts the cursor on its record.
click logfield-ATT.Roll
doubleclick loggrid-2-3
expect log.cursor.line > 0

# Export Files from the log that carries some: a folder beside it.
click log-name
key Escape
type gpsfix.bin
key Return
expect log.grid.rows > 0
click loggrid-0-3:right
click loggrid-menu-files
expect log.prompt Where to save the files
type files
click log-prompt-ok
expect log.prompt none
expect log.exported 5 files
