# Initial Setup's Install Firmware page labels each vehicle from the firmware catalogue, and a
# vehicle's click downloads the file Mission Planner would flash to the board and reads it -
# stopping where it would write to the board, which it never does.
#
# ConfigFirmwareManifest.cs: Activate fetches the manifest (APFirmware.GetList) and writes the newest
# firmware of the release under each vehicle picture, OFFICIAL until "Beta firmwares" is clicked.
# A picture's click asks "Are you sure you want to upload ...?"; Yes runs LookForPort, which finds
# the board from the USB product string and takes its firmware - through FirmwareSelection when
# several files fit, which opens on the board's own platform and waits for "Upload Firmware" -
# downloads it with the progress bar and status line following, and hands it to UploadFlash,
# which reads it and stops before the reboot into the bootloader. Deactivate puts the release back
# to OFFICIAL, and the catalogue, a static in the C#, is not fetched again.
#
# Self-contained and offline: the catalogue is testdata/firmware/manifest.json.gz, an excerpt of
# the real manifest, served in place of the network; MP_FIRMWARE_MIRROR is a directory standing in
# for the web, holding a synthetic .apj - not a firmware - where the Copter build for CubeOrange is,
# and nothing where the beta heli build is; the one USB device is a CubeOrange in its bootloader,
# whatever is plugged into this machine; and the data and temporary directories are scratch ones,
# so no link Mission Planner remembers is opened - with a vehicle connected the C# shows
# ConfigFirmwareDisabled instead.

env XDG_DATA_HOME $WORK
env TMPDIR $WORK
env MP_FIRMWARE_MANIFEST $WORK/manifest.json.gz
env MP_FIRMWARE_MIRROR $WORK/web
env MP_FIRMWARE_DEVICE CubeOrange-BL
setup cp testdata/firmware/manifest.json.gz $WORK/manifest.json.gz
setup mkdir -p "$WORK/web/firmware.ardupilot.org/Copter/stable/CubeOrange" && cp crates/mp-firmware/testdata/legacy/arducopter.apj "$WORK/web/firmware.ardupilot.org/Copter/stable/CubeOrange/arducopter.apj"

screen setup
window 1600x1200
budget 12

expect config.firmware.active false
# Install Firmware is the first entry of InitialSetup's list, outside any heading; disconnected,
# the list shows ConfigFirmwareManifest (InitialSetup.cs:169-173).
click setup-page-ConfigFirmwareManifest
expect config.firmware.active true
expect config.firmware.page manifest
expect config.firmware.manifest loaded
expect config.firmware.manifest.records 240
expect config.firmware.manifest.fetches 1
expect config.firmware.release OFFICIAL
expect config.firmware.enabled true
expect config.firmware.label.quad Copter V4.7.1 OFFICIAL
expect config.firmware.label.plane Plane V4.7.1 OFFICIAL
expect config.firmware.label.tracker AntennaTracker V4.7.1 OFFICIAL
expect config.firmware.board CubeOrange-BL
expect config.firmware.board.ids 140
expect config.firmware.status Status
expect config.firmware.upload disabled

# Copter, official: the question first; No does nothing.
click fw-quad
expect config.firmware.question Are you sure you want to upload Copter V4.7.1 OFFICIAL?
click fw-question-no
expect config.firmware.question none
expect config.firmware.vehicle none

# Yes: three CubeOrange builds share board id 140, and FirmwareSelection opens on the board's own
# platform, its one file selected.
click fw-quad
click fw-question-yes
expect config.firmware.vehicle Copter
expect config.firmware.candidates 3
expect config.firmware.chosen https://firmware.ardupilot.org/Copter/stable/CubeOrange/arducopter.apj
expect config.firmware.chosen.version 4.7.1
expect config.firmware.selection 1
expect config.firmware.selection.selected https://firmware.ardupilot.org/Copter/stable/CubeOrange/arducopter.apj
expect config.firmware.message none

# Upload Firmware: the download to a temporary file, read - board 140, a 3,000-byte image - and
# stopped before the reboot into the bootloader.
click fw-select-upload
expect config.firmware.selection 0
expect config.firmware.flow done
expect config.firmware.flow.board pass
expect config.firmware.download.url https://firmware.ardupilot.org/Copter/stable/CubeOrange/arducopter.apj
expect config.firmware.download.size 654
expect config.firmware.apj.board_id 140
expect config.firmware.apj.image 3000
expect config.firmware.progress 100
expect config.firmware.status Reading Hex File
expect config.firmware.stopped the next step would reboot the board into its bootloader and upload the image: flashing is not enabled in this build

# Beta firmwares: the labels and the choice follow the release. The beta heli build is the only
# one for the board, so it downloads at once - and it is not in the mirror: "Failed download".
click fw-beta
expect config.firmware.release BETA
expect config.firmware.label.quad Copter V4.7.1 BETA
expect config.firmware.vehicle none
click fw-heli
click fw-question-yes
expect config.firmware.vehicle HELICOPTER
expect config.firmware.chosen https://firmware.ardupilot.org/Copter/beta/CubeOrange-heli/arducopter-heli.apj
expect config.firmware.message Failed download
click fw-message-ok
expect config.firmware.message none
expect config.firmware.flow done
expect config.firmware.download.url none

# All Options: every record of the catalogue, and FirmwareSelection on the board's platform - its
# 80 CubeOrange files, none selected, so Upload Firmware waits for a choice.
click fw-alloptions
expect config.firmware.selection 80
expect config.firmware.selection.selected none
click fw-select-close
expect config.firmware.selection 0

# Choosing another entry is Deactivate: back to OFFICIAL, and reopening fetches nothing. Disconnected,
# the Mandatory Hardware heading is not listed (InitialSetup.cs:182), so Optional Hardware is used.
click setup-page-ConfigOptional
expect config.firmware.active false
expect config.firmware.release OFFICIAL
click setup-page-ConfigFirmwareManifest
expect config.firmware.active true
expect config.firmware.manifest.fetches 1
expect config.firmware.label.quad Copter V4.7.1 OFFICIAL
