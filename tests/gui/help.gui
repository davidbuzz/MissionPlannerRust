# The HELP screen: GCSViews/Help.cs, Help.Designer.cs and Help.resx, ported in
# crates/mp-gui/src/help.rs over crates/mp-update (Utilities/Update.cs, Updater/Program.cs).
#
# The claim: MainV2's HELP tab shows the help text with Check for Updates, Check for BETA Updates,
# Show Console Window (restart) and the Change Log link (Help.resx); Show Console Window writes
# showconsole (Help.cs:50-53). Updates are refused, the owner's word of 2026-10-14 - "for both of
# them to *ONLY* print "Sorry, Updates arent impleented yet", and do noting more": each button
# puts help.rs's UPDATES_NOT_IMPLEMENTED on the status line and starts nothing, and MainV2's check
# at startup (MainV2.cs:3668-3678) does not run - though the settings below, a channel with a
# newer beta on it, beta_updates on and today already checked, would have asked "BETA Update
# Found" at once. The update server runs so that a request, were one made, would be answered.
#
# Against tests/gui/update-server.py, a channel on 127.0.0.1:5793.
#
# Needs no link: tools/gui-headless.sh help

env XDG_DATA_HOME $WORK
env MP_UPDATE_DIR $WORK/install
env MP_OPEN_WITH_SHELL_LOG $WORK/opened.txt
setup mkdir -p "$WORK/install" "$WORK/MissionPlannerRust" && printf '1.0.0.0\n' > "$WORK/install/version.txt"
setup python3 tests/gui/update-server.py --work $WORK --port 5793
setup printf '<?xml version="1.0" encoding="utf-8"?><Config><UpdateLocationVersion>http://127.0.0.1:5793/version.txt</UpdateLocationVersion><UpdateLocationMD5>http://127.0.0.1:5793/checksums.txt</UpdateLocationMD5><UpdateLocation>http://127.0.0.1:5793/files/</UpdateLocation><BetaUpdateLocationVersion>http://127.0.0.1:5793/beta/version.txt</BetaUpdateLocationVersion><BetaUpdateLocationMD5>http://127.0.0.1:5793/beta/checksums.txt</BetaUpdateLocationMD5><BetaUpdateLocationZip>http://127.0.0.1:5793/beta/Beta.zip</BetaUpdateLocationZip><update_check>%s</update_check><beta_updates>True</beta_updates></Config>' "$(date +%-m/%-d/%Y)" > "$WORK/MissionPlannerRust/config.xml"

screen help
window 1600x1200
budget 6

expect screen help

# No check at startup: nothing asked.
expect help.flow idle
expect help.last none

# Show Console Window (restart): the setting, and nothing else here.
expect help.console false
click help-showconsole
expect help.console true
click help-showconsole
expect help.console false

# Check for Updates: the words on the status line, and nothing started.
expect help.refused 0
click help-updatecheck
expect help.refused 1
expect status.drawn Sorry, Updates aren't implemented yet
expect help.flow idle
expect help.last none

# Check for BETA Updates: the same, and nothing downloaded or started.
click help-betaupdate
expect help.refused 2
expect status.drawn Sorry, Updates aren't implemented yet
expect help.flow idle
expect help.written 0
expect help.last none
expect help.restart none

# The guide to Tailscale, the owner's plan of 2026-10-14, while Tailscale is enabled in PLUGINS (it
# is until unticked): its link hands the guide's address to the desktop's browser.
expect help.tailscale true
expect help.opened none
click help-tailscale
expect help.opened https://github.com/davidbuzz/MissionPlannerRust/blob/main/using_tailscale.md
