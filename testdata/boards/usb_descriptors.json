    { "line": "132", "about": "the old-style names are exact: the bootloader's 'PX4 BL' string is not one", "devices": [ { "board": "PX4 BL FMU v4.x", "hardwareid": "USB\\VID_26AC&PID_0012" } ], "expect": "no_match" },
    { "line": "82,131", "about": "a new-style id is tested before the product string, so a px4 name on it is a ChibiOS name", "devices": [ { "board": "PX4 FMU v4.x", "hardwareid": "USB\\VID_1209&PID_5740" } ], "expect": { "board": "chbootloader", "chbootloader": "PX4 FMU v4.x" } },
