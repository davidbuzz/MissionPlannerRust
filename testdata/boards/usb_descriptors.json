    { "line": "72", "about": "first match wins across the list, the other way round", "devices": [ { "board": "fmuv2", "hardwareid": "USB\\VID_1209&PID_5740" }, { "board": "PX4 FMU v4.x", "hardwareid": "USB\\VID_26AC&PID_0012" } ], "expect": { "board": "px4v2" } },
    { "line": "72", "about": "an unknown device is passed over for a later one", "devices": [ { "board": "USB Serial", "hardwareid": "USB\\VID_0403&PID_6001" }, { "board": "PX4 FMU v1.x", "hardwareid": "USB\\VID_26AC&PID_0010" } ], "expect": { "board": "px4" } },
