    { "line": "132", "about": "a null product on any other id is a null-safe == and passed over", "devices": [ { "board": null, "hardwareid": "USB\\VID_0403&PID_6001" }, { "board": "fmuv3", "hardwareid": "USB\\VID_1209&PID_5740" } ], "expect": { "board": "px4v3" } },
