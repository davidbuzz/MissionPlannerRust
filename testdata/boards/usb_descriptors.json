{
  "source": "Utilities/BoardDetect.cs @ efb0801",
  "about": [
    "USB descriptors for every board and id BoardDetect.cs names, built from the C#'s own constants; 'line' cites the rule each entry exercises.",
    "'devices' entries are a DeviceInfo list (ExtLibs/ArduPilot/DeviceInfo.cs) for the device-list rules, BoardDetect.cs:66-197. A null field is the C# null. Where a rule matches on the vendor id alone (VID_2DAE, VID_3162) the product id is whatever the C# test used for that vendor, or 0000 where it has none: the rule does not read it.",
    "'serial_ports' entries are Win32_SerialPort rows (PNPDeviceID, Name) and the port asked about, for BoardDetect.cs:199-368. PNP ids end '\\0' as BoardDetect.cs:134 shows one, or with the serial number BoardDetect.cs:486 shows for the Arduino Mega. A Name is only read for the port in brackets.",
    "'expect' is {\"board\": b}, {\"board\": \"chbootloader\", \"chbootloader\": name}, {\"probe\": \"fmu_v2_or_v3\" | \"chibios_or_px4\"} or \"no_match\"."
  ],
  "devices": [
    { "line": "82,87-91", "about": "STM32 CDC id, fmuv2", "devices": [ { "board": "fmuv2", "hardwareid": "USB\\VID_0483&PID_5740" } ], "expect": { "board": "px4v2" } },
    { "line": "85,87-91", "about": "ArduPilot id, fmuv2 bootloader", "devices": [ { "board": "fmuv2-bl", "hardwareid": "USB\\VID_1209&PID_5740" } ], "expect": { "board": "px4v2" } },
    { "line": "83,87-91", "about": "CubePilot vendor id, the -bl compare is case-insensitive", "devices": [ { "board": "FMUv2-BL", "hardwareid": "USB\\VID_2DAE&PID_0016" } ], "expect": { "board": "px4v2" } },
    { "line": "82,93-97", "about": "fmuv3", "devices": [ { "board": "fmuv3", "hardwareid": "USB\\VID_0483&PID_5740" } ], "expect": { "board": "px4v3" } },
    { "line": "85,93-97", "about": "fmuv3 bootloader, with the REV_ Windows appends", "devices": [ { "board": "fmuv3-bl", "hardwareid": "USB\\VID_1209&PID_5740&REV_0200" } ], "expect": { "board": "px4v3" } },
    { "line": "84,99-103", "about": "Holybro vendor id, fmuv4", "devices": [ { "board": "fmuv4", "hardwareid": "USB\\VID_3162&PID_0000" } ], "expect": { "board": "px4v4" } },
    { "line": "85,99-103", "about": "fmuv4 bootloader in mixed case", "devices": [ { "board": "fmuv4-BL", "hardwareid": "USB\\VID_1209&PID_5740" } ], "expect": { "board": "px4v4" } },
    { "line": "85,99,128", "about": "the plain name is compared exactly, so upper case is a ChibiOS name", "devices": [ { "board": "FMUV4", "hardwareid": "USB\\VID_1209&PID_5740" } ], "expect": { "board": "chbootloader", "chbootloader": "FMUV4" } },
    { "line": "105-108,128", "about": "fmuv5 is only logged, then a ChibiOS name", "devices": [ { "board": "fmuv5", "hardwareid": "USB\\VID_1209&PID_5740" } ], "expect": { "board": "chbootloader", "chbootloader": "fmuv5" } },
    { "line": "105-108,128", "about": "fmuv5 bootloader, -bl stripped", "devices": [ { "board": "fmuv5-bl", "hardwareid": "USB\\VID_1209&PID_5740" } ], "expect": { "board": "chbootloader", "chbootloader": "fmuv5" } },
    { "line": "110-114,128", "about": "revo-mini: its return is commented out", "devices": [ { "board": "revo-mini-bl", "hardwareid": "USB\\VID_0483&PID_5740" } ], "expect": { "board": "chbootloader", "chbootloader": "revo-mini" } },
    { "line": "116-120,128", "about": "mini-pix: its return is commented out", "devices": [ { "board": "mini-pix", "hardwareid": "USB\\VID_0483&PID_5740" } ], "expect": { "board": "chbootloader", "chbootloader": "mini-pix" } },
    { "line": "122-126,128", "about": "mindpx-v2: its return is commented out; -Bl stripped", "devices": [ { "board": "mindpx-v2-Bl", "hardwareid": "USB\\VID_0483&PID_5740" } ], "expect": { "board": "chbootloader", "chbootloader": "mindpx-v2" } },
